{
  "name": "el-par",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "verify": "npm run check && npm run build && node scripts/verify-build.mjs",
    "format": "prettier --write src astro.config.mjs scripts tests playwright.config.ts",
    "format:check": "prettier --check src astro.config.mjs scripts tests playwright.config.ts",
    "test:e2e": "playwright test",
    "test:content": "node scripts/verify-growth.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "axe-core": "^4.14.0",
    "image-size": "^2.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3"
  }
}
