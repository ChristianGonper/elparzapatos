---
/**
 * Lightbox.astro — Visor Fotográfico Minimalista a Pantalla Completa
 * Inspección fotográfica serena en máxima definición sobre fondo cálido.
 * Fuente de verdad: sitio/DESIGN.md (§4.6), sitio/specs/migracion-astro/spec.md (§3.3.10)
 */

export interface Props {
  id?: string;
}

export type LightboxProps = Props;

const { id = "specimen-lightbox" } = Astro.props;
---

<dialog
  id={id}
  class="specimen-lightbox"
  aria-modal="true"
  aria-label="Visor fotográfico de espécimen"
>
  <div class="lightbox-wrapper" data-lightbox-backdrop>
    <!-- Botón de cierre tipográfico desnudo con amplia área táctil -->
    <button
      type="button"
      class="lightbox-close"
      aria-label="Cerrar visor"
      data-lightbox-close
    >
      <span class="close-text">Cerrar</span>
    </button>

    <!-- Contenedor central de la imagen de espécimen -->
    <div class="lightbox-stage">
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
    </div>

    <!-- Pie de imagen o leyenda accesible -->
    <div class="lightbox-footer">
      <p id="lightbox-caption" class="lightbox-caption" aria-live="polite"></p>
    </div>
  </div>
</dialog>

<script>
  /**
   * Controlador nativo Vanilla JS del Lightbox de espécimen
   * Interacción accesible: ratón, pulsación táctil y teclado (Enter, Espacio, Escape)
   */
  function setupLightbox() {
    const dialog = document.getElementById(
      "specimen-lightbox",
    ) as HTMLDialogElement | null;
    if (!dialog) return;

    const img = dialog.querySelector<HTMLImageElement>("#lightbox-image");
    const caption = dialog.querySelector<HTMLElement>("#lightbox-caption");
    const closeBtn = dialog.querySelector<HTMLButtonElement>(
      "[data-lightbox-close]",
    );
    const backdropWrapper = dialog.querySelector<HTMLElement>(
      "[data-lightbox-backdrop]",
    );

    let lastTrigger: HTMLElement | null = null;
    let originalBodyOverflow = "";

    function openLightbox(trigger: HTMLElement) {
      if (!dialog || !img) return;

      lastTrigger = trigger;
      const src = trigger.getAttribute("data-lightbox-src") || "";
      const alt = trigger.getAttribute("data-lightbox-alt") || "";
      const capText = trigger.getAttribute("data-lightbox-caption") || alt;

      img.src = src;
      img.alt = alt;

      if (caption) {
        caption.textContent = capText;
      }

      originalBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";

      if (!dialog.open) {
        dialog.showModal();
      }

      // Colocar el foco en el botón de cierre para navegación accesible inmediata
      if (closeBtn) {
        closeBtn.focus();
      }
    }

    function closeLightbox() {
      if (!dialog || !dialog.open) return;

      dialog.close();
      document.body.style.overflow = originalBodyOverflow;

      if (img) {
        img.src = "";
        img.alt = "";
      }
      if (caption) {
        caption.textContent = "";
      }

      if (lastTrigger && typeof lastTrigger.focus === "function") {
        lastTrigger.focus();
      }
      lastTrigger = null;
    }

    // Delegación de eventos para disparadores (click y teclado)
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const trigger = target.closest<HTMLElement>("[data-lightbox-trigger]");
      if (trigger) {
        event.preventDefault();
        openLightbox(trigger);
      }
    });

    document.addEventListener("keydown", (event) => {
      // Activar disparador con teclado (Enter o Espacio)
      if (event.key === "Enter" || event.key === " ") {
        const activeElement = document.activeElement as HTMLElement | null;
        if (
          activeElement &&
          activeElement.hasAttribute("data-lightbox-trigger") &&
          !dialog.open
        ) {
          event.preventDefault();
          openLightbox(activeElement);
        }
      }
    });

    // Cierre al pulsar el botón específico
    if (closeBtn) {
      closeBtn.addEventListener("click", (event) => {
        event.stopPropagation();
        closeLightbox();
      });
    }

    // Cierre al hacer clic fuera del contenido central (sobre el fondo o contenedor)
    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      // Si se pulsa directamente sobre el wrapper exterior o el dialog
      if (target === dialog || target === backdropWrapper) {
        closeLightbox();
      }
    });

    // Soporte para la tecla Escape y el evento nativo 'cancel' de <dialog>
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeLightbox();
    });
  }

  // Inicialización idempotente
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLightbox);
  } else {
    setupLightbox();
  }

  // Soporte para transiciones de página de Astro (astro:page-load)
  document.addEventListener("astro:page-load", setupLightbox);
</script>

<style>
  /* ==========================================================================
     VISOR MODAL LIGHTBOX A PANTALLA COMPLETA
     Fondo cálido sereno (#FAF8F5 al 96% con desenfoque suave)
     ========================================================================== */

  .specimen-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background-color: rgba(250, 248, 245, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-ink, #1c1a18);
    display: none;
    z-index: 1000;
  }

  .specimen-lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .specimen-lightbox::backdrop {
    background-color: rgba(250, 248, 245, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Envolvente de interacción y clic exterior (Lienzo con cursor zoom-out) */
  .lightbox-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6) var(--space-4);
    box-sizing: border-box;
    cursor: zoom-out;
  }

  @media (min-width: 768px) {
    .lightbox-wrapper {
      padding: var(--space-8) var(--space-8);
    }
  }

  /* Botón de cierre tipográfico desnudo con amplia área táctil para móvil y escritorio */
  .lightbox-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 64px;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest, 0.2em);
    font-weight: 500;
    color: var(--color-graphite, #6b6661);
    cursor: pointer;
    user-select: none;
    transition: color var(--transition-hover, 0.15s ease);
    z-index: 1010;
  }

  @media (min-width: 768px) {
    .lightbox-close {
      top: var(--space-6);
      right: var(--space-8);
    }
  }

  .lightbox-close:hover,
  .lightbox-close:focus {
    color: var(--color-cognac, #9e6b55);
    background: transparent;
    outline: none;
  }

  .lightbox-close:focus-visible {
    outline: 2px solid var(--color-cognac, #9e6b55);
    outline-offset: 2px;
  }

  .close-text {
    display: inline-block;
  }

  /* Escenario central de exhibición con cursor zoom-out en áreas vacías */
  .lightbox-stage {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* Permite que los clics pasen al backdrop salvo en la imagen */
    cursor: zoom-out;
  }

  .lightbox-image {
    max-width: 92vw;
    max-height: 80vh;
    object-fit: contain;
    pointer-events: auto; /* La imagen no cierra el visor al pulsarse */
    cursor: default;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (min-width: 768px) {
    .lightbox-image {
      max-height: 85vh;
    }
  }

  /* Pie de imagen o leyenda discreta */
  .lightbox-footer {
    width: 100%;
    max-width: 48rem;
    text-align: center;
    pointer-events: none;
    margin-top: var(--space-3);
  }

  .lightbox-caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    text-transform: uppercase;
    color: var(--color-graphite, #6b6661);
    line-height: var(--leading-normal, 1.5);
  }

  .lightbox-caption:empty {
    display: none;
  }
</style>
