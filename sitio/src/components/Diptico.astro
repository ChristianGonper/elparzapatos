---
/**
 * Diptico.astro — Pliego Fotográfico Morfológico Continuo a Dos Caras
 * Unidad fotográfica indisoluble con correspondencia morfológica dual.
 * Fuente de verdad: sitio/DESIGN.md (§4.2, §5), sitio/specs/migracion-astro/spec.md (§3.3.7)
 * Referencia visual: sitio/archivo-prototipos/mock-comparativas-visuales.html (líneas 653-736)
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface DipticoItem {
  image: ImageMetadata;
  alt: string;
  label?: string;
  sublabel?: string;
}

export interface Props {
  imagenes: [DipticoItem, DipticoItem];
  titulo?: string;
  ejeMorfologico?: string;
  pieCentrado?: string;
  aspectRatio?: '4:3' | '1:1' | '3:4' | '16:10' | 'auto';
  triggerLightbox?: boolean;
  class?: string;
}

export type DipticoProps = Props;

const {
  imagenes,
  titulo = 'Díptico Morfológico · Observación Simultánea',
  ejeMorfologico,
  pieCentrado,
  aspectRatio = '4:3',
  triggerLightbox = true,
  class: className = '',
} = Astro.props;

const [panelA, panelB] = imagenes;

const aspectClassMap = {
  '4:3': 'aspect-4-3',
  '1:1': 'aspect-1-1',
  '3:4': 'aspect-3-4',
  '16:10': 'aspect-16-10',
  'auto': 'aspect-auto',
};

const selectedAspectClass = aspectClassMap[aspectRatio] || 'aspect-4-3';
---

<div class:list={['diptico-wrapper', className]}>
  <!-- Marco continuo indisoluble de dos fotografías contiguas -->
  <div class="diptico-frame">
    <!-- Encabezado sutil integrado con título o rótulo -->
    <div class="diptico-header">
      <span class="diptico-titulo">
        <span class="punto-cognac" aria-hidden="true"></span>
        {titulo}
      </span>
      <span class="diptico-criterio">Unidad Fotográfica Indisoluble · Correspondencia 1:1</span>
    </div>

    <!-- Retícula a 2 caras con discreto filete de separación de 1px -->
    <div class="diptico-grid">
      <!-- Panel 1 -->
      <div
        class:list={['diptico-panel', { 'is-interactive': triggerLightbox }]}
        tabindex={triggerLightbox ? 0 : undefined}
        role={triggerLightbox ? 'button' : undefined}
        aria-label={triggerLightbox ? `Inspeccionar espécimen: ${panelA.alt}` : undefined}
        data-lightbox-trigger={triggerLightbox ? '' : undefined}
        data-lightbox-src={triggerLightbox ? panelA.image.src : undefined}
        data-lightbox-alt={triggerLightbox ? panelA.alt : undefined}
        data-lightbox-caption={triggerLightbox ? (panelA.label ? `${panelA.label}${panelA.sublabel ? ` — ${panelA.sublabel}` : ''}` : panelA.alt) : undefined}
      >
        <div class:list={['diptico-viewport', selectedAspectClass]}>
          <Image
            src={panelA.image}
            alt={panelA.alt}
            class="diptico-img"
          />
        </div>
        {(panelA.label || panelA.sublabel) && (
          <div class="diptico-legend">
            {panelA.label && <span class="legend-label">{panelA.label}</span>}
            {panelA.sublabel && <span class="legend-sublabel">{panelA.sublabel}</span>}
          </div>
        )}
      </div>

      <!-- Panel 2 -->
      <div
        class:list={['diptico-panel', { 'is-interactive': triggerLightbox }]}
        tabindex={triggerLightbox ? 0 : undefined}
        role={triggerLightbox ? 'button' : undefined}
        aria-label={triggerLightbox ? `Inspeccionar espécimen: ${panelB.alt}` : undefined}
        data-lightbox-trigger={triggerLightbox ? '' : undefined}
        data-lightbox-src={triggerLightbox ? panelB.image.src : undefined}
        data-lightbox-alt={triggerLightbox ? panelB.alt : undefined}
        data-lightbox-caption={triggerLightbox ? (panelB.label ? `${panelB.label}${panelB.sublabel ? ` — ${panelB.sublabel}` : ''}` : panelB.alt) : undefined}
      >
        <div class:list={['diptico-viewport', selectedAspectClass]}>
          <Image
            src={panelB.image}
            alt={panelB.alt}
            class="diptico-img"
          />
        </div>
        {(panelB.label || panelB.sublabel) && (
          <div class="diptico-legend">
            {panelB.label && <span class="legend-label">{panelB.label}</span>}
            {panelB.sublabel && <span class="legend-sublabel">{panelB.sublabel}</span>}
          </div>
        )}
      </div>
    </div>

    <!-- Pie técnico de correspondencia dual -->
    {ejeMorfologico && (
      <div class="diptico-pie-tecnico">
        <span class="eje-texto">Eje morfológico: {ejeMorfologico}</span>
        <span class="eje-insignia">Pliego de correspondencia dual</span>
      </div>
    )}
  </div>

  <!-- Cierre explicativo centrado al pie -->
  {pieCentrado && (
    <div class="diptico-cierre">
      <p class="diptico-cierre-texto">
        {pieCentrado}
      </p>
    </div>
  )}
</div>

<style>
  /* ==========================================================================
     DÍPTICO MORFOLÓGICO CONTINUO (Marco Unificado Indisoluble)
     ========================================================================== */

  .diptico-wrapper {
    width: 100%;
    max-width: 64rem; /* max-w-5xl (1024px) centrado */
    margin: 0 auto;
  }

  .diptico-frame {
    position: relative;
    background-color: var(--color-specimen, #FFFFFF);
    border: 1px solid var(--color-hairline, #E8E3DC);
    border-radius: var(--radius-lg, 8px);
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  @media (min-width: 640px) {
    .diptico-frame {
      padding: var(--space-6) var(--space-6) var(--space-8);
    }
  }

  @media (min-width: 768px) {
    .diptico-frame {
      padding: var(--space-8);
    }
  }

  /* Encabezado sutil integrado con título y punto cognac */
  .diptico-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem; /* 10px */
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest, 0.2em);
    color: var(--color-graphite, #6B6661);
    margin-bottom: var(--space-5);
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-hairline, #E8E3DC);
  }

  .diptico-titulo {
    color: var(--color-cognac, #9E6B55);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .punto-cognac {
    width: 6px;
    height: 6px;
    background-color: var(--color-cognac, #9E6B55);
    display: inline-block;
  }

  .diptico-criterio {
    display: none;
  }

  @media (min-width: 640px) {
    .diptico-criterio {
      display: inline-block;
    }
  }

  /* Retícula a 2 caras con filete de separación de 1px */
  .diptico-grid {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-hairline, #E8E3DC);
    border-radius: var(--radius-md, 6px);
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-paper-muted, #F3EFEA) 25%, transparent);
  }

  @media (min-width: 768px) {
    .diptico-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Paneles independientes con interacción accesible */
  .diptico-panel {
    position: relative;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    outline: none;
    transition:
      background-color var(--transition-hover, 0.15s ease),
      box-shadow var(--transition-serene, 0.2s cubic-bezier(0.16, 1, 0.3, 1));
  }

  @media (min-width: 640px) {
    .diptico-panel {
      padding: var(--space-6);
    }
  }

  /* Borde separador entre caras: abajo en móvil, derecha en escritorio */
  .diptico-panel:first-child {
    border-bottom: 1px solid var(--color-hairline, #E8E3DC);
  }

  @media (min-width: 768px) {
    .diptico-panel:first-child {
      border-bottom: none;
      border-right: 1px solid var(--color-hairline, #E8E3DC);
    }
  }

  .diptico-panel.is-interactive {
    cursor: crosshair;
  }

  .diptico-panel.is-interactive:hover,
  .diptico-panel.is-interactive:focus,
  .diptico-panel.is-interactive:focus-within {
    background-color: color-mix(in srgb, var(--color-paper, #FAF8F5) 80%, white);
    box-shadow: inset 0 0 0 1px var(--color-cognac, #9E6B55);
  }

  /* Ventana fotográfica flexible con proporción fotográfica seleccionable */
  .diptico-viewport {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: var(--radius-sm, 4px);
  }

  .aspect-4-3 {
    aspect-ratio: 4 / 3;
  }

  .aspect-1-1 {
    aspect-ratio: 1 / 1;
  }

  .aspect-3-4 {
    aspect-ratio: 3 / 4;
  }

  .aspect-16-10 {
    aspect-ratio: 16 / 10;
  }

  .aspect-auto {
    min-height: 220px;
    max-height: 480px;
  }

  .diptico-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: none !important;
    transition: none !important;
  }

  /* Leyenda técnica inferior del panel */
  .diptico-legend {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--color-hairline, #E8E3DC) 60%, transparent);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem; /* 10px */
    letter-spacing: var(--tracking-mono-widest, 0.2em);
    text-transform: uppercase;
    color: var(--color-graphite, #6B6661);
  }

  .legend-label {
    color: var(--color-ink, #1C1A18);
    font-weight: 500;
  }

  .legend-sublabel {
    color: var(--color-graphite, #6B6661);
  }

  /* Pie técnico del díptico continuo */
  .diptico-pie-tecnico {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-hairline, #E8E3DC);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem; /* 10px */
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    text-transform: uppercase;
    color: var(--color-graphite, #6B6661);
  }

  @media (min-width: 640px) {
    .diptico-pie-tecnico {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .eje-insignia {
    color: var(--color-cognac, #9E6B55);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Cierre explicativo centrado al pie */
  .diptico-cierre {
    max-width: 42rem; /* max-w-2xl */
    margin: var(--space-8) auto 0;
    padding: 0 var(--space-4);
    text-align: center;
  }

  .diptico-cierre-texto {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-prose, 1.75);
    color: var(--color-graphite, #6B6661);
    font-style: italic;
    border-top: 1px solid var(--color-hairline, #E8E3DC);
    padding-top: var(--space-6);
  }
</style>
