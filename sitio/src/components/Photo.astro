---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  zoom?: boolean;
}
const {
  src,
  alt,
  sizes = '(max-width: 700px) 100vw, 60vw',
  priority = false,
  class: className,
  zoom = false,
} = Astro.props;
// AVIF para quien lo admite y WebP para el resto, en los anchos que no superan el original.
const widths = [480, 960, 1600].filter((width) => width <= src.width);
const large = zoom
  ? await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' })
  : undefined;
---

{zoom && large ? (
  <button
    class:list={['photo-zoom', className]}
    data-image-zoom={large.src}
    data-image-caption={alt}
    aria-label={`Agrandar foto: ${alt}`}
  >
    <Picture
      {src}
      {alt}
      {widths}
      {sizes}
      formats={['avif']}
      fallbackFormat="webp"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="zoom-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </span>
  </button>
) : (
  <Picture
    {src}
    {alt}
    {widths}
    {sizes}
    class={className}
    formats={['avif']}
    fallbackFormat="webp"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
)}
