---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  zoom?: boolean;
}
const {
  src,
  alt,
  sizes = '(max-width: 700px) 100vw, 60vw',
  priority = false,
  class: className,
  zoom = false,
} = Astro.props;
// AVIF para quien lo admite y WebP para el resto, en los anchos que no superan el original.
// Con zoom, la foto es un enlace a su versión grande: el visor la abre encima y, sin
// JavaScript, el navegador la abre sola.
const widths = [480, 960, 1600].filter((width) => width <= src.width);
const large = zoom
  ? await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' })
  : undefined;
---

{zoom && large ? (
  <a
    class:list={['photo-zoom', className]}
    href={large.src}
    data-pswp-width={large.attributes.width}
    data-pswp-height={large.attributes.height}
    aria-label={`Ver en grande: ${alt}`}
  >
    <Picture
      {src}
      {alt}
      {widths}
      {sizes}
      formats={['avif']}
      fallbackFormat="webp"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </a>
) : (
  <Picture
    {src}
    {alt}
    {widths}
    {sizes}
    class={className}
    formats={['avif']}
    fallbackFormat="webp"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
)}
