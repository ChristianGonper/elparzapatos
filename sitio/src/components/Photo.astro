---
interface Props {
  base: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  priority?: boolean;
  class?: string;
  zoom?: boolean;
  max?: number;
}
const {
  base,
  alt,
  width = 1600,
  height = 1200,
  sizes = '(max-width: 700px) 100vw, 60vw',
  priority = false,
  class: className,
  zoom = false,
  max = 1600,
} = Astro.props;
const srcset = [480, 960, 1600]
  .filter((w) => w <= max)
  .map((w) => `${base}-${w}.webp ${w}w`)
  .join(', ');
---

{zoom ? (
  <button
    class:list={['photo-zoom', className]}
    data-image-zoom={`${base}-${max}.webp`}
    data-image-caption={alt}
    aria-label={`Agrandar foto: ${alt}`}
  >
    <img
      src={`${base}-${max}.webp`}
      {srcset}
      {sizes}
      {width}
      {height}
      {alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="zoom-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </span>
  </button>
) : (
  <img
    class={className}
    src={`${base}-${max}.webp`}
    {srcset}
    {sizes}
    {width}
    {height}
    {alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
)}
