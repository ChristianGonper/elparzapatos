---
import Photo from './Photo.astro';
import { currentAnalysis } from '../data/analysis';
import { pairImage } from '../data/images';
interface Props {
  title: string;
  image: number;
  caption: string;
  imageSide?: 'left' | 'right';
  id?: string;
  /**
   * Punto que el texto señala en la foto, en % desde arriba a la izquierda (0 a 100), y su
   * tamaño opcional en % del ancho de la foto. Se marca al leer el detalle (docs/CONTENIDO.md).
   */
  x?: number;
  y?: number;
  size?: number;
  /** Cómo se marca: círculo (por defecto), flecha o recuadro. */
  marca?: 'circulo' | 'flecha' | 'recuadro';
  /** Solo con flecha: desde qué lado llega. Sin él, desde el lado con más sitio. */
  desde?: 'izquierda' | 'derecha' | 'arriba' | 'abajo';
}
const {
  title,
  image,
  caption,
  imageSide = 'left',
  id,
  x,
  y,
  size = 12,
  marca = 'circulo',
  desde,
} = Astro.props;
const pair = currentAnalysis(Astro.locals);
const hasPoint = x !== undefined || y !== undefined;
if (hasPoint) {
  for (const [name, value] of [
    ['x', x],
    ['y', y],
    ['size', size],
  ] as const)
    if (value === undefined || !(value >= 0 && value <= 100))
      throw new Error(`${pair.id} · «${title}»: el punto necesita ${name} entre 0 y 100.`);
}
if (!['circulo', 'flecha', 'recuadro'].includes(marca))
  throw new Error(
    `${pair.id} · «${title}»: marca «${marca}» no existe (circulo, flecha o recuadro).`,
  );
if (desde && !['izquierda', 'derecha', 'arriba', 'abajo'].includes(desde))
  throw new Error(`${pair.id} · «${title}»: desde «${desde}» no existe.`);
// La flecha llega, si no se elige, desde el lado horizontal con más sitio.
const side = marca === 'flecha' ? (desde ?? ((x ?? 50) < 50 ? 'derecha' : 'izquierda')) : undefined;
const headingId =
  id ??
  `detalle-${image}-${title
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')}`;
---

<section
  class:list={['wrap', 'article-section', { 'image-first': imageSide === 'left' }]}
  aria-labelledby={headingId}
>
  <header class="article-section-heading">
    <h2 id={headingId}>{title}</h2>
  </header>
  <figure>
    {hasPoint ? (
      <div
        class="detail-photo"
        data-marca={marca}
        data-desde={side}
        style={`--x: ${x}%; --y: ${y}%; --size: ${size}`}
      >
        <Photo
          src={pairImage(pair, image)}
          alt={caption}
          zoom
          sizes="(max-width: 800px) 92vw, 45vw"
        />
        <span class="detail-mark" aria-hidden="true">
          {marca === 'flecha' && (
            <svg viewBox="0 0 104 22" preserveAspectRatio="none">
              <path
                d="M3 11h88M80 3l11 8-11 8"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </span>
      </div>
    ) : (
      <Photo
        src={pairImage(pair, image)}
        alt={caption}
        zoom
        sizes="(max-width: 800px) 92vw, 45vw"
      />
    )}
    <figcaption>{caption}</figcaption>
  </figure>
  <div class="article-text">
    <slot />
  </div>
</section>
