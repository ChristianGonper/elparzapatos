---
/**
 * Abstract.astro — Apertura Editorial a Dos Columnas (Variante 1A: Pliego de Arte)
 * Entradilla de síntesis visual que sitúa la pieza y agrupa sus rasgos dominantes.
 * Fuente de verdad: sitio/DESIGN.md (§3, §5), sitio/specs/migracion-astro/spec.md (§3.3.5)
 * Referencia visual: sitio/archivo-prototipos/entradas/salon-aguja.html (líneas 150-157)
 */

export interface Props {
  parrafo1?: string;
  parrafo2?: string;
  class?: string;
}

export type AbstractProps = Props;

const {
  parrafo1,
  parrafo2,
  class: className = '',
} = Astro.props;

const hasNamedSlots = Astro.slots.has('col1') || Astro.slots.has('col2');
---

<div class:list={['abstract-editorial', className]}>
  {hasNamedSlots ? (
    <>
      <div class="abstract-col">
        <slot name="col1">{parrafo1 && <p>{parrafo1}</p>}</slot>
      </div>
      <div class="abstract-col">
        <slot name="col2">{parrafo2 && <p>{parrafo2}</p>}</slot>
      </div>
    </>
  ) : (parrafo1 || parrafo2) ? (
    <>
      <div class="abstract-col">
        {parrafo1 && <p>{parrafo1}</p>}
      </div>
      <div class="abstract-col">
        {parrafo2 && <p>{parrafo2}</p>}
      </div>
    </>
  ) : (
    <slot />
  )}
</div>

<style>
  /* ==========================================================================
     ABSTRACT EDITORIAL EN DOS COLUMNAS (Pliego de Arte)
     Retícula fluida paralela en desktop y apilado suave en móvil.
     ========================================================================== */

  .abstract-editorial {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 56rem; /* max-w-4xl (896px) centrado */
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-16);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-prose, 1.75);
    color: var(--color-graphite);
  }

  @media (min-width: 768px) {
    .abstract-editorial {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem; /* gap-14 */
      font-size: var(--text-lg);
    }
  }

  .abstract-col,
  .abstract-editorial :global(p) {
    margin: 0;
  }

  .abstract-col > :global(* + *) {
    margin-top: var(--space-4);
  }
</style>
