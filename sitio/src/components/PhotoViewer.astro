<script>
  // Visor de fotos con PhotoSwipe. Cada foto ampliable es un enlace a su versión grande
  // (a.photo-zoom); el visor se carga al abrir la primera y agrupa todas las de la página.
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  import { onEveryPage } from '../scripts/every-page';
  // Al navegar sin recargar, el contenido cambia: se cierra el visor de la página anterior y se
  // prepara otro para la nueva.
  let current: { gallery: HTMLElement; lightbox: PhotoSwipeLightbox } | undefined;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const setUp = () => {
    const gallery = document.querySelector<HTMLElement>('#contenido');
    if (!gallery || gallery === current?.gallery) return;
    current?.lightbox.destroy();
    current = undefined;
    if (!gallery.querySelector('a.photo-zoom')) return;
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a.photo-zoom',
      pswpModule: () => import('photoswipe'),
      mainClass: 'photo-viewer',
      bgOpacity: 1,
      showHideAnimationType: 'fade',
      // Se abre con la foto entera y se acerca con un clic, la rueda o los dedos.
      initialZoomLevel: 'fit',
      imageClickAction: 'zoom',
      wheelToZoom: true,
      paddingFn: (viewport) =>
        viewport.x > 700
          ? { top: 64, bottom: 72, left: 72, right: 72 }
          : { top: 56, bottom: 64, left: 0, right: 0 },
      closeTitle: 'Cerrar fotografía',
      zoomTitle: 'Acercar o alejar',
      arrowPrevTitle: 'Foto anterior',
      arrowNextTitle: 'Foto siguiente',
      errorMsg: 'No se ha podido cargar la foto. Cierra y vuelve a intentarlo.',
      indexIndicatorSep: ' de ',
    });
    lightbox.on('uiRegister', () => {
      // El pie de cada foto, el mismo texto que la describe en la página.
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        className: 'photo-viewer-caption',
        order: 9,
        appendTo: 'root',
        onInit: (element, pswp) => {
          pswp.on('change', () => {
            element.textContent = pswp.currSlide?.data.alt ?? '';
          });
        },
      });
    });
    lightbox.on('afterInit', () => {
      lightbox.pswp?.element?.setAttribute('aria-label', 'Fotografía ampliada');
    });
    // La foto crece desde su miniatura y vuelve a ella al cerrar; sin movimiento si quien visita
    // lo ha pedido.
    gallery.addEventListener(
      'click',
      () => {
        lightbox.options.showHideAnimationType = reduceMotion.matches ? 'none' : 'zoom';
      },
      { capture: true },
    );
    lightbox.init();
    current = { gallery, lightbox };
  };
  onEveryPage(setUp);
</script>
