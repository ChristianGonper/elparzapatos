<script>
  // Visor de fotos con PhotoSwipe. Cada foto ampliable es un enlace a su versión grande
  // (a.photo-zoom); el visor se carga al abrir la primera y agrupa todas las de la página.
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  if (document.querySelector('a.photo-zoom')) {
    const lightbox = new PhotoSwipeLightbox({
      gallery: '#contenido',
      children: 'a.photo-zoom',
      pswpModule: () => import('photoswipe'),
      mainClass: 'photo-viewer',
      bgOpacity: 1,
      showHideAnimationType: 'fade',
      // Se abre con la foto entera y se acerca con un clic, la rueda o los dedos.
      initialZoomLevel: 'fit',
      imageClickAction: 'zoom',
      wheelToZoom: true,
      paddingFn: (viewport) =>
        viewport.x > 700
          ? { top: 64, bottom: 72, left: 72, right: 72 }
          : { top: 56, bottom: 64, left: 0, right: 0 },
      closeTitle: 'Cerrar fotografía',
      zoomTitle: 'Acercar o alejar',
      arrowPrevTitle: 'Foto anterior',
      arrowNextTitle: 'Foto siguiente',
      errorMsg: 'No se ha podido cargar la foto. Cierra y vuelve a intentarlo.',
      indexIndicatorSep: ' de ',
    });
    lightbox.on('uiRegister', () => {
      // El pie de cada foto, el mismo texto que la describe en la página.
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        className: 'photo-viewer-caption',
        order: 9,
        appendTo: 'root',
        onInit: (element, pswp) => {
          pswp.on('change', () => {
            element.textContent = pswp.currSlide?.data.alt ?? '';
          });
        },
      });
    });
    lightbox.on('afterInit', () => {
      lightbox.pswp?.element?.setAttribute('aria-label', 'Fotografía ampliada');
    });
    lightbox.init();
  }
</script>
