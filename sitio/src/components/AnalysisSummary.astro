---
import { currentAnalysis } from '../data/analysis';
const pair = currentAnalysis(Astro.locals);
---

<div class="wrap">
  <section class="at-a-glance" aria-labelledby="glance-heading">
    <div>
      <h2 id="glance-heading">De un vistazo</h2>
    </div>
    <dl>
      <div>
        <dt>Tipo</dt>
        <dd>{pair.type}</dd>
      </div>
      {pair.brand && (
        <div>
          <dt>Marca</dt>
          <dd>{pair.brand}</dd>
        </div>
      )}
      {pair.model && (
        <div>
          <dt>Modelo</dt>
          <dd>{pair.model}</dd>
        </div>
      )}
      <div>
        <dt>Fotos</dt>
        <dd>{pair.credit}</dd>
      </div>
      <div>
        <dt>Lo que miramos</dt>
        <dd>{pair.focus}</dd>
      </div>
    </dl>
  </section>
</div>
