---
interface Props {
  direction?: 'right' | 'left';
}
const { direction = 'right' } = Astro.props;
---

<svg
  width="21"
  height="21"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class:list={{ 'arrow-left': direction === 'left' }}
>
  <path
    d="M4 12h15M13 6l6 6-6 6"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
