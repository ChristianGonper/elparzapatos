---
/**
 * GlossaryPopover.astro — Término Técnico con Tarjeta Flotante Contextual
 * Glosario anatómico y biomecánico accesible sin interrumpir la lectura.
 * Fuente de verdad: sitio/DESIGN.md (§4.3, §6, §7), sitio/specs/migracion-astro/spec.md (§3.3.9)
 * Referencia visual: sitio/archivo-prototipos/mock-comparativas-visuales.html (líneas 98-137, 1099-1138)
 */

export interface Props {
  termino: string;
  traduccionEn?: string;
  definicion: string;
  funcionBiomecanica?: string;
  class?: string;
}

export type GlossaryPopoverProps = Props;

const {
  termino,
  traduccionEn,
  definicion,
  funcionBiomecanica,
  class: className = '',
} = Astro.props;

const headerText = traduccionEn ? `${termino} (${traduccionEn})` : termino;
---

<span
  class:list={['popover-term', className]}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  data-glossary-popover
>
  <slot>{termino}</slot>
  <span class="popover-card" role="tooltip" aria-hidden="true">
    <strong class="popover-header">{headerText}</strong>
    <span class="popover-definicion">{definicion}</span>
    {funcionBiomecanica && (
      <span class="popover-biomecanica">
        <strong class="biomecanica-label">Función biomecánica:</strong> {funcionBiomecanica}
      </span>
    )}
  </span>
</span>

<script>
  /**
   * Controlador nativo Vanilla JS para popovers anatómicos contextuales
   * Interacción: hover, clic, teclado (Enter, Espacio, Escape) y contención en viewport.
   */
  function setupGlossaryPopovers() {
    const terms = document.querySelectorAll<HTMLElement>('[data-glossary-popover]');
    if (!terms.length) return;

    function hideAllPopovers() {
      terms.forEach((t) => {
        const c = t.querySelector<HTMLElement>('.popover-card');
        if (c) {
          c.classList.remove('is-visible');
          c.classList.remove('is-flipped');
          c.setAttribute('aria-hidden', 'true');
        }
        t.setAttribute('aria-expanded', 'false');
      });
    }

    function showPopover(term: HTMLElement) {
      const card = term.querySelector<HTMLElement>('.popover-card');
      if (!card) return;

      hideAllPopovers();

      card.classList.add('is-visible');
      card.setAttribute('aria-hidden', 'false');
      term.setAttribute('aria-expanded', 'true');

      // Calibración de posición respecto al viewport
      positionCard(card);
    }

    function togglePopover(term: HTMLElement) {
      const isVisible = term.getAttribute('aria-expanded') === 'true';
      if (isVisible) {
        hideAllPopovers();
      } else {
        showPopover(term);
      }
    }

    function positionCard(card: HTMLElement) {
      // Restablecer transform para medir dimensión natural
      card.style.left = '50%';
      card.style.transform = 'translateX(-50%)';

      const rect = card.getBoundingClientRect();
      const margin = 16;
      const viewportWidth = window.innerWidth;

      // Inversión vertical si la tarjeta se saldría por la parte superior
      if (rect.top < margin) {
        card.classList.add('is-flipped');
      } else {
        card.classList.remove('is-flipped');
      }

      // Ajuste horizontal si desborda por los extremos de la pantalla
      if (rect.left < margin) {
        const offset = margin - rect.left;
        card.style.transform = `translateX(calc(-50% + ${offset}px))`;
      } else if (rect.right > viewportWidth - margin) {
        const offset = rect.right - (viewportWidth - margin);
        card.style.transform = `translateX(calc(-50% - ${offset}px))`;
      }
    }

    // Inicializar listeners sobre cada término (evitando listeners duplicados)
    terms.forEach((term) => {
      if (term.dataset.popoverInitialized === 'true') return;
      term.dataset.popoverInitialized = 'true';

      // 1. Interacción con ratón (hover)
      term.addEventListener('mouseenter', () => {
        showPopover(term);
      });

      term.addEventListener('mouseleave', () => {
        hideAllPopovers();
      });

      // 2. Interacción con pulsación / clic
      term.addEventListener('click', (event) => {
        event.stopPropagation();
        togglePopover(term);
      });

      // 3. Interacción con teclado (Enter o Espacio para alternar, Esc para cerrar)
      term.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          togglePopover(term);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          hideAllPopovers();
        }
      });
    });

    // Delegación global para clic en el exterior y Escape
    const globalWindow = window as unknown as { __glossaryGlobalListenerAttached?: boolean };
    if (!globalWindow.__glossaryGlobalListenerAttached) {
      globalWindow.__glossaryGlobalListenerAttached = true;

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target || !target.closest('[data-glossary-popover]')) {
          hideAllPopovers();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          hideAllPopovers();
        }
      });
    }
  }

  // Inicialización idempotente
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGlossaryPopovers);
  } else {
    setupGlossaryPopovers();
  }

  // Soporte para transiciones de página de Astro (astro:page-load)
  document.addEventListener('astro:page-load', setupGlossaryPopovers);
</script>

<style>
  /* ==========================================================================
     GLOSSARY POPOVER (Término Anatómico y Tarjeta Contextual)
     Subrayado punteado en color cuero cognac y tarjeta Paper Canvas.
     ========================================================================== */

  .popover-term {
    position: relative;
    display: inline;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--color-cognac);
    text-underline-offset: 4px;
    cursor: pointer;
    font-weight: 500;
    color: var(--color-ink);
    transition: color var(--transition-hover, 0.15s ease);
    outline: none;
  }

  .popover-term:hover,
  .popover-term:focus,
  .popover-term[aria-expanded='true'] {
    color: var(--color-cognac);
  }

  /* Tarjeta flotante contextual */
  .popover-card {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: 280px;
    max-width: calc(100vw - 2rem);
    padding: 0.875rem 1rem;
    background-color: var(--color-paper, #FAF8F5);
    border: 1px solid var(--color-hairline, #E8E3DC);
    box-shadow: var(--shadow-modal, 0 10px 25px -5px rgba(28, 26, 24, 0.08));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--transition-serene, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--transition-serene, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      visibility 0.2s;
    z-index: 50;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-style: normal;
    text-decoration: none;
    white-space: normal;
  }

  /* Estado visible */
  .popover-card.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(-2px);
  }

  /* Triángulo indicador apuntando hacia abajo */
  .popover-card::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: var(--color-paper, #FAF8F5) transparent transparent transparent;
  }

  /* Inversión vertical si la tarjeta no cabe arriba */
  .popover-card.is-flipped {
    bottom: auto;
    top: calc(100% + 10px);
  }

  .popover-card.is-flipped.is-visible {
    transform: translateX(-50%) translateY(2px);
  }

  .popover-card.is-flipped::after {
    top: auto;
    bottom: 100%;
    border-color: transparent transparent var(--color-paper, #FAF8F5) transparent;
  }

  /* Encabezado del término: Mono versalitas cognac */
  .popover-header {
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    color: var(--color-cognac);
    font-weight: 500;
    display: block;
    line-height: var(--leading-tight, 1.15);
  }

  /* Definición anatómica en sans-serif */
  .popover-definicion {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: var(--leading-normal, 1.5);
    color: var(--color-ink);
    display: block;
  }

  /* Función biomecánica adicional */
  .popover-biomecanica {
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 0.6875rem; /* 11px */
    line-height: var(--leading-normal, 1.5);
    color: var(--color-graphite);
    display: block;
  }

  .biomecanica-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-tag, 0.06em);
    color: var(--color-cognac);
    font-size: 0.625rem; /* 10px */
    font-weight: 500;
  }
</style>
