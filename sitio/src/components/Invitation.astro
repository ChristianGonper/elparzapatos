---
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import { commonInvitation, type InvitationContent } from '../data/invitations';
interface Props {
  content?: InvitationContent;
  compact?: boolean;
  /** Ancla de la sección, para enlazarla (la guía usa #enviar). */
  id?: string;
}
const { content = commonInvitation, compact = false, id } = Astro.props;
const titleId = `${id ?? 'invitacion'}-titulo`;
const { label, title, text, action, note, image } = content;
---

<section
  class:list={['invitation', { compact, 'with-image': image }]}
  {id}
  aria-labelledby={titleId}
>
  <div class="wrap invitation-inner">
    {image && (
      <figure class="invitation-image">
        <Photo src={image.src} alt={image.alt} sizes="(max-width: 800px) 90vw, 40vw" />
      </figure>
    )}
    <div class="invitation-heading">
      <span class="eyebrow">{label}</span>
      <h2 id={titleId}>
        {title[0]}
        <br />
        <em>{title[1]}</em>
      </h2>
    </div>
    <div class="invitation-copy">
      <p>{text}</p>
      <a class="button" href={action.href}>
        {action.label} <Arrow />
      </a>
      {note && <p class="small-note">{note}</p>}
    </div>
  </div>
</section>
