---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section
  class:list={['invitation', { compact }]}
  aria-labelledby={compact ? 'invitation-title-compact' : 'invitation-title'}
>
  <div class="wrap invitation-inner">
    <div>
      <span class="eyebrow">El siguiente puede ser el tuyo</span>
      <h2 id={compact ? 'invitation-title-compact' : 'invitation-title'}>
        ¿Nos enseñas
        <br />
        <em>tus zapatos?</em>
      </h2>
    </div>
    <div class="invitation-copy">
      <p>
        Ese par que te encanta tiene mucho que mirar. Hazle unas fotos con el móvil y lo contamos en
        El Par.
      </p>
      <a class="button" href={site.tally}>
        Enviar mis fotos <Arrow />
      </a>
      <p class="small-note">Solo nos envías fotos. Los zapatos se quedan contigo.</p>
      <a class="text-link" href="/participa/">
        Así se participa <Arrow />
      </a>
    </div>
  </div>
</section>
