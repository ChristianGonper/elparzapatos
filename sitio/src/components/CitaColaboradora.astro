---
/**
 * CitaColaboradora.astro — Testimonio Personal Honesto de la Colaboradora
 * Voz directa y memoria de uso del calzado en cursiva literaria y filete de cuero.
 * Fuente de verdad: sitio/DESIGN.md (§3, §4.1), sitio/specs/migracion-astro/spec.md (§3.3.8)
 * Referencia visual: sitio/archivo-prototipos/mock-comparativas-visuales.html (líneas 436-451, 569-581)
 */

export interface Props {
  texto?: string;
  autora: string;
  rol?: string;
  posicion?: 'apertura' | 'detalle' | 'cierre';
  etiqueta?: string;
  class?: string;
}

export type CitaColaboradoraProps = Props;

const {
  texto,
  autora,
  rol = 'Dueña del par',
  posicion = 'cierre',
  etiqueta,
  class: className = '',
} = Astro.props;

// Envolver en comillas españolas « » si el texto proporcionado por prop no las tiene
function asegurarComillas(str: string): string {
  const trimmed = str.trim();
  if (
    (trimmed.startsWith('«') && trimmed.endsWith('»')) ||
    (trimmed.startsWith('"') && trimmed.endsWith('"'))
  ) {
    return trimmed;
  }
  return `«${trimmed}»`;
}

const textoFormateado = texto ? asegurarComillas(texto) : undefined;
---

<figure
  class:list={[
    'cita-colaboradora',
    `posicion-${posicion}`,
    className,
  ]}
  aria-label={`Testimonio de ${autora}`}
>
  {etiqueta && (
    <div class="cita-etiqueta">
      <span>{etiqueta}</span>
    </div>
  )}

  <blockquote class="cita-cuerpo">
    {textoFormateado ? (
      <p class="cita-texto">{textoFormateado}</p>
    ) : (
      <slot />
    )}
  </blockquote>

  <figcaption class="cita-firma">
    <span class="cita-autora">{autora}</span>
    <span class="cita-separador" aria-hidden="true">·</span>
    <span class="cita-rol">{rol}</span>
  </figcaption>
</figure>

<style>
  /* ==========================================================================
     CITA TESTIMONIAL DE COLABORADORA
     Encuadre honesto en Newsreader cursiva, fondo Muted Linen y filete cognac.
     ========================================================================== */

  .cita-colaboradora {
    margin: 0;
    width: 100%;
    border-left: 2px solid var(--color-cognac);
    background-color: color-mix(in srgb, var(--color-linen) 85%, var(--color-paper));
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .cita-colaboradora {
      padding: var(--space-8) var(--space-8) var(--space-8) var(--space-10);
      gap: var(--space-4);
    }
  }

  /* Etiqueta opcional previa (mono versalitas) */
  .cita-etiqueta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    text-transform: uppercase;
    color: var(--color-cognac);
    font-weight: 500;
  }

  /* Bloque de cita textual */
  .cita-cuerpo {
    margin: 0;
    padding: 0;
  }

  .cita-texto,
  .cita-cuerpo :global(p) {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: normal;
    line-height: var(--leading-prose, 1.75);
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .cita-texto,
    .cita-cuerpo :global(p) {
      font-size: var(--text-2xl);
    }
  }

  /* Firma y rol en JetBrains Mono */
  .cita-firma {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-tag, 0.06em);
    padding-top: var(--space-2);
  }

  .cita-autora {
    color: var(--color-cognac);
    font-weight: 500;
  }

  .cita-separador {
    color: var(--color-hairline);
    user-select: none;
  }

  .cita-rol {
    color: var(--color-graphite);
    font-weight: normal;
  }
</style>
