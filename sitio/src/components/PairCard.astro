---
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import { pairPath, type Pair } from '../data/pairs';
import { pairImage } from '../data/images';
interface Props {
  pair: Pair;
  sizes?: string;
  /** Nivel del título: h3 cuando la tarjeta va dentro de una sección con su propio h2. */
  heading?: 'h2' | 'h3';
}
const { pair, sizes = '(max-width: 700px) 90vw, 50vw', heading: Heading = 'h2' } = Astro.props;
---

<a class="pair-card" href={pairPath(pair)}>
  <div class="card-image">
    <Photo src={pairImage(pair, pair.hero)} alt={pair.photoAlt} {sizes} />
  </div>
  <div class="card-meta">
    <span>
      {pair.type} · {pair.credit}
    </span>
  </div>
  <Heading>{pair.title}</Heading>
  <p>{pair.teaser}</p>
  <span class="card-read">
    Leer a fondo <Arrow />
  </span>
</a>
