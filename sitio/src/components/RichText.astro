---
import Term from './Term.astro';
interface Props {
  text: string;
  id: string;
}
const { text, id } = Astro.props;
const parts = text.split(/(\[\[[^\]]+\]\])/g);
---

<p>
  {parts.map((part, i) => {
    if (!part.startsWith('[[')) return part;
    const [slug, label] = part.slice(2, -2).split('|');
    return <Term {slug} {label} id={`${id}-${i}`} />;
  })}
</p>
