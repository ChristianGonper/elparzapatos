---
import { glossary } from '../data/glossary';
interface Props {
  slug: string;
  label?: string;
  id: string;
}
const { slug, label, id } = Astro.props;
const term = glossary.find((t) => t.slug === slug);
if (!term) throw new Error(`Término desconocido: ${slug}`);
---

<button class="term" popovertarget={id} aria-expanded="false" aria-controls={id}>
  {label ?? term.name.toLocaleLowerCase('es')}
</button>
<aside class="term-popover" popover id={id} aria-label={`Definición de ${term.name}`}>
  <div class="popover-heading">
    <span class="eyebrow">Un detalle, un nombre</span>
    <button
      class="close-button"
      popovertarget={id}
      popovertargetaction="hide"
      aria-label="Cerrar definición"
    >
      ×
    </button>
  </div>
  <h2>{term.name}</h2>
  <p>{term.definition}</p>
  <a class="text-link" href={`/glosario/#${term.slug}`}>
    Ver en el glosario <span aria-hidden="true">↗</span>
  </a>
</aside>
