---
import { glossary } from '../data/glossary';
interface Props {
  slug: string;
  label?: string;
  id?: string;
}
const { slug, label, id = `term-${crypto.randomUUID()}` } = Astro.props;
const term = glossary.find((t) => t.slug === slug);
if (!term) throw new Error(`Término desconocido: ${slug}`);
---

<button class="term" popovertarget={id} aria-expanded="false" aria-controls={id}>
  {label ?? term.name.toLocaleLowerCase('es')}
</button>
<span class="term-popover" popover id={id} role="dialog" aria-label={`Definición de ${term.name}`}>
  <strong class="term-title">{term.name}</strong>
  <span class="term-definition">{term.definition}</span>
  <a class="text-link" href={`/glosario/#${term.slug}`}>
    Todas las palabras, en el glosario <span aria-hidden="true">↗</span>
  </a>
</span>

<script>
  import { enCadaPagina, primeraVez } from '../scripts/cada-pagina';
  // Sin JavaScript, el botón abre y cierra la definición con el popover nativo. Con JavaScript:
  // - con el ratón, se abre al pasar por la palabra y se cierra sola al quitarlo (también si se
  //   ha hecho clic), salvo mientras el ratón está sobre la tarjeta;
  // - con un toque (o Intro), se abre y se queda hasta tocar fuera de la palabra o la tarjeta,
  //   volver a tocar la palabra o pulsar Esc;
  // - con el teclado, se abre al llegar a la palabra y se cierra al salir de ella o con Esc.
  type Term = {
    button: HTMLButtonElement;
    popover: HTMLElement;
    pinned: boolean;
    pointer?: string;
    quiet?: boolean;
    timer?: number;
  };
  const anchored = window.matchMedia('(min-width: 541px)');
  let terms: Term[] = [];
  const isOpen = (term: Term) => term.popover.matches(':popover-open');
  const place = (term: Term) => {
    const { popover, button } = term;
    if (!anchored.matches) {
      popover.classList.remove('is-anchored');
      return;
    }
    popover.classList.add('is-anchored');
    // La palabra puede partirse en dos líneas: se toma el trozo de la primera.
    const word = button.getClientRects()[0] ?? button.getBoundingClientRect();
    const margin = 16;
    const width = popover.offsetWidth;
    const height = popover.offsetHeight;
    const left = Math.min(Math.max(word.left, margin), window.innerWidth - width - margin);
    const below = word.bottom + 8;
    const top =
      below + height <= window.innerHeight - margin || word.top - height - 8 < margin
        ? below
        : word.top - height - 8;
    popover.style.setProperty('--term-left', `${left}px`);
    popover.style.setProperty('--term-top', `${Math.max(margin, top)}px`);
  };
  const show = (term: Term, pinned: boolean) => {
    window.clearTimeout(term.timer);
    term.pinned = pinned;
    for (const other of terms) if (other !== term && isOpen(other)) hide(other);
    if (!isOpen(term)) term.popover.showPopover();
    place(term);
  };
  const hide = (term: Term) => {
    window.clearTimeout(term.timer);
    term.pinned = false;
    if (isOpen(term)) term.popover.hidePopover();
  };
  const hideSoon = (term: Term) => {
    window.clearTimeout(term.timer);
    if (!term.pinned) term.timer = window.setTimeout(() => hide(term), 250);
  };
  const setUp = (popover: HTMLElement) => {
    if (!primeraVez(popover)) return;
    const button = document.querySelector<HTMLButtonElement>(`[aria-controls="${popover.id}"]`);
    if (!button) return;
    const term: Term = { button, popover, pinned: false };
    terms.push(term);
    popover.popover = 'manual';
    button.removeAttribute('popovertarget');
    popover.addEventListener('toggle', (event: Event) => {
      button.setAttribute('aria-expanded', String((event as ToggleEvent).newState === 'open'));
    });
    button.addEventListener('pointerdown', (event) => (term.pointer = event.pointerType));
    button.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      window.clearTimeout(term.timer);
      if (!isOpen(term)) term.timer = window.setTimeout(() => show(term, false), 120);
    });
    for (const element of [button, popover]) {
      element.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && isOpen(term) && !term.pinned)
          window.clearTimeout(term.timer);
      });
      element.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') hideSoon(term);
      });
    }
    button.addEventListener('click', (event) => {
      const pointer = event.detail === 0 ? 'keyboard' : term.pointer;
      term.pointer = undefined;
      // Con el ratón, el clic no la deja fija: ya está abierta por pasar por encima.
      if (pointer === 'mouse') {
        if (!isOpen(term)) show(term, false);
        return;
      }
      if (isOpen(term) && term.pinned) hide(term);
      else show(term, true);
    });
    button.addEventListener('focus', () => {
      if (!term.quiet && button.matches(':focus-visible') && !isOpen(term)) show(term, false);
    });
    for (const element of [button, popover])
      element.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && (button.contains(next) || popover.contains(next))) return;
        // Al salir con el teclado se cierra; una definición tocada sigue hasta tocar fuera.
        if (!term.pinned || next) hide(term);
      });
  };
  // Tras navegar sin recargar se olvidan las palabras de la página anterior.
  enCadaPagina(() => {
    terms = terms.filter((term) => term.button.isConnected);
    document.querySelectorAll<HTMLElement>('.term-popover').forEach(setUp);
  });
  document.addEventListener('pointerdown', (event) => {
    const target = event.target as Node;
    for (const term of terms)
      if (isOpen(term) && !term.button.contains(target) && !term.popover.contains(target))
        hide(term);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const term of terms) {
      if (!isOpen(term)) continue;
      const focused =
        term.popover.contains(document.activeElement) || term.button === document.activeElement;
      hide(term);
      if (focused) {
        // Devuelve el foco a la palabra sin que vuelva a abrirse.
        term.quiet = true;
        term.button.focus();
        term.quiet = false;
      }
    }
  });
  const replace = () => terms.filter(isOpen).forEach(place);
  window.addEventListener('scroll', replace, { passive: true });
  window.addEventListener('resize', replace);
</script>
