---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/dm-sans';
import '../styles/index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import { site, siteUrl, launchReady } from '../data/site';
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image = '/imagenes/maria/vista-05-1600.webp',
  noindex = false,
} = Astro.props;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const allowIndex = !!siteUrl && launchReady && !noindex;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.name ? `${site.name} · ${site.descriptor}` : `${title} · ${site.name}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="robots" content={allowIndex ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="El Par" />
    <meta property="og:title" content={`${title} · Zapatos en detalle`} />
    <meta property="og:description" content={description} />
    {siteUrl && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(image, siteUrl).href} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PhotoViewer />
  </body>
</html>
