---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/dm-sans';
import '../styles/index.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { guideImage } from '../data/images';
import { site, siteUrl, launchReady, includeDrafts } from '../data/site';
interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
}
const { title, description, image = guideImage(5), noindex = false } = Astro.props;
// Imagen para compartir: JPEG de 1200 px, el formato que aceptan todas las redes. Su nombre
// depende solo de la foto y de estas opciones, así que no cambia entre compilaciones.
const shareImage = siteUrl
  ? await getImage({ src: image, width: 1200, format: 'jpeg', quality: 82 })
  : undefined;
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const allowIndex = !!siteUrl && launchReady && !noindex;
// El mismo título en la pestaña y al compartir: «[página] · El Par» o, en la portada, «El Par · Zapatos en detalle».
const pageTitle =
  title === site.name ? `${site.name} · ${site.descriptor}` : `${title} · ${site.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="robots" content={allowIndex ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="El Par" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {siteUrl && (
      <>
        <meta property="og:url" content={canonical} />
        {shareImage && <meta property="og:image" content={new URL(shareImage.src, siteUrl).href} />}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <Header />
    {includeDrafts && <div class="review-notice">Vista de revisión · incluye borradores</div>}
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <PhotoViewer />
  </body>
</html>
