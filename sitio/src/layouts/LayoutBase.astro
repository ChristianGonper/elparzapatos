---
/**
 * LayoutBase.astro — Armazón HTML5 y Shell Global
 * Fuente de verdad de arquitectura: sitio/specs/migracion-astro/spec.md
 * Sistema visual de referencia: sitio/DESIGN.md
 */

import '../styles/tokens.css';
import '../styles/reset.css';
import Lightbox from '../components/Lightbox.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title = 'El Par — Zapatos en detalle | Colección y Monografías Editoriales',
  description = 'Publicación editorial independiente y colección monográfica digital de calzado. Estudio formal, fotográfico y anatómico del zapato como objeto de arte y arquitectura.',
  ogImage,
  currentPath = Astro.url.pathname,
} = Astro.props;

// Construcción de la URL canónica y resolución de imagen OpenGraph
const siteUrl = Astro.site || Astro.url;
const canonicalURL = new URL(currentPath, siteUrl);
const resolvedOgImage = ogImage ? new URL(ogImage, canonicalURL).href : undefined;

// Token de Cloudflare Web Analytics desde variable de entorno pública
const cfAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Metadatos técnicos y codificación -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconexión y carga de tipografías canónicas de Google Fonts -->
    <!-- Newsreader (serif con opsz y cursivas), Plus Jakarta Sans (sans) y JetBrains Mono (mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Metadatos OpenGraph para previsualización social -->
    <meta property="og:site_name" content="El Par — Zapatos en detalle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    <!-- Metadatos Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- Analítica Web Privada y Ética (Cloudflare Web Analytics, sin cookies ni rastreo) -->
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      />
    )}
  </head>
  <body>
    <slot />
    <Lightbox />
  </body>
</html>
