---
/**
 * LayoutMonografia.astro — Envolvente de Pliego Monográfico Editorial
 * Fuente de verdad: sitio/specs/monografia/spec.md y sitio/specs/migracion-astro/spec.md
 * Sistema visual de referencia: sitio/DESIGN.md
 */

import LayoutBase from './LayoutBase.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  currentPath?: string;
  titulo?: string;
  subtitulo?: string;
  armario?: string;
  fechaPublicacion?: Date | string;
}

const {
  title,
  description,
  ogImage,
  currentPath = Astro.url.pathname,
  titulo,
  subtitulo,
  armario,
  fechaPublicacion,
} = Astro.props;

const isoFecha =
  fechaPublicacion instanceof Date
    ? fechaPublicacion.toISOString()
    : fechaPublicacion;

// Composición del título de página editorial si no se proporciona directamente
const pageTitle =
  title ||
  (titulo
    ? `El Par — ${titulo}${subtitulo ? ` | ${subtitulo}` : ''}`
    : 'El Par — Monografía Editorial');

// Descripción por defecto basada en los datos de la monografía
const pageDescription =
  description ||
  (titulo && subtitulo
    ? `${titulo}. ${subtitulo}${armario ? ` Procede del ${armario}.` : ''} Publicación monográfica en El Par.`
    : undefined);
---

<LayoutBase
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  currentPath={currentPath}
>
  <!-- Barra superior monográfica en el flujo normal (sale con el scroll) -->
  <header class="monografia-header">
    <div class="header-container">
      <!-- Retorno sutil y accesible a la Colección -->
      <a href="/#coleccion" class="back-link" title="Regresar a la Colección principal">
        <span class="back-arrow" aria-hidden="true">&larr;</span>
        <span>Volver a la Colección</span>
      </a>

      <!-- Presencia centralizada de marca -->
      <div class="brand-block">
        <a href="/" class="brand-name" title="El Par — Inicio">El Par</a>
        <span class="brand-descriptor">/ Zapatos en detalle</span>
      </div>

      <!-- Procedencia del espécimen o equilibrio visual -->
      <div class="armario-block">
        {armario ? (
          <span class="armario-label">{armario}</span>
        ) : (
          <span class="armario-placeholder" aria-hidden="true" />
        )}
      </div>
    </div>
  </header>

  <!-- Envolvente de pliego editorial centrado -->
  <main class="monografia-main">
    <article class="monografia-pliego" data-published-time={isoFecha}>
      <slot />
    </article>

    <!-- Cierre editorial consistente con invitación sutil -->
    <slot name="cierre">
      <section class="cierre-editorial" aria-label="Invitación a colaborar">
        <div class="cierre-card">
          <div class="cierre-texto">
            <span class="cierre-supratitulo">Comparte un par</span>
            <p class="cierre-mensaje">
              {armario
                ? `Este estudio ha sido posible gracias a la generosidad de ${armario}. Si conservas algún par con una silueta singular, una arquitectura particular o un detalle artesanal que merezca verse de cerca, puedes proponérnoslo para formar parte del archivo.`
                : 'Si conservas algún par con una silueta singular, una arquitectura particular o un detalle artesanal que merezca verse de cerca, puedes proponérnoslo para formar parte del archivo.'}
            </p>
          </div>
          <a href="/como-colaborar" class="cierre-accion">
            <span>Cómo colaborar</span>
            <span class="accion-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </section>
    </slot>
  </main>
  <Footer currentPath={currentPath} hideColaborarLink={true} />
</LayoutBase>

<style>
  /* ==========================================================================
     CABECERA MONOGRÁFICA
     Flujo normal, discreta y enérgica sin barras fijas artificiales.
     ========================================================================== */
  .monografia-header {
    width: 100%;
    background-color: var(--color-paper);
    border-bottom: 1px solid var(--color-hairline);
    position: static;
  }

  .header-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--min-tap-target);
    padding: 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-graphite);
    user-select: none;
    transition: color var(--transition-hover);
    white-space: nowrap;
    flex: 1;
  }

  .back-link:hover {
    color: var(--color-cognac);
  }

  .back-arrow {
    font-size: 1.15em;
    line-height: 1;
    transition: transform var(--transition-hover);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  .brand-block {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    justify-content: center;
    flex: 2;
    text-align: center;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: normal;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    transition: opacity var(--transition-hover);
  }

  .brand-name:hover {
    opacity: 0.85;
  }

  .brand-descriptor {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-cognac);
    font-weight: 500;
  }

  .armario-block {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 1;
    text-align: right;
  }

  .armario-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-graphite);
    white-space: nowrap;
  }

  .armario-placeholder {
    display: inline-block;
    width: var(--space-4);
  }

  /* ==========================================================================
     PLIEGO EDITORIAL Y CONTENEDOR PRINCIPAL
     ========================================================================== */
  .monografia-main {
    flex-grow: 1;
    width: 100%;
  }

  .monografia-pliego {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6) var(--space-12);
  }

  /* ==========================================================================
     CIERRE EDITORIAL DE COLABORACIÓN
     Fórmula fija "Comparte un par" con superficie Muted Linen y filete crisp.
     ========================================================================== */
  .cierre-editorial {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-20);
  }

  .cierre-card {
    background-color: var(--color-linen);
    border: 1px solid var(--color-hairline);
    padding: var(--space-8) var(--space-10);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cierre-card {
      flex-direction: row;
      align-items: center;
      gap: var(--space-10);
    }
  }

  .cierre-texto {
    max-width: var(--max-w-prose);
  }

  .cierre-supratitulo {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-cognac);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .cierre-mensaje {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink);
    margin: 0;
  }

  .cierre-accion {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--min-tap-target);
    padding: 0 var(--space-1) var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    font-weight: 500;
    user-select: none;
    white-space: nowrap;
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .cierre-accion:hover {
    color: var(--color-cognac);
    border-color: var(--color-cognac);
  }

  .accion-arrow {
    transition: transform var(--transition-hover);
  }

  .cierre-accion:hover .accion-arrow {
    transform: translateX(3px);
  }

  /* ==========================================================================
     RESPONSIVE EDITORIAL (MÓVIL < 768px)
     ========================================================================== */
  @media (max-width: 768px) {
    .header-container {
      height: auto;
      padding: var(--space-3) var(--space-4);
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .brand-block {
      order: 1;
      flex: 1 1 100%;
      justify-content: flex-start;
      margin-bottom: var(--space-1);
    }

    .brand-descriptor {
      display: none;
    }

    .back-link {
      order: 2;
      flex: 1 1 60%;
      min-height: var(--min-tap-target);
      padding: 0;
    }

    .armario-block {
      order: 3;
      flex: 1 1 35%;
    }

    .monografia-pliego {
      padding: var(--space-6) var(--space-4) var(--space-8);
    }

    .cierre-editorial {
      padding: 0 var(--space-4) var(--space-12);
    }

    .cierre-card {
      padding: var(--space-6) var(--space-6);
    }
  }
</style>
