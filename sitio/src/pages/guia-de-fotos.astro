---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Invitation from '../components/Invitation.astro';
import QuickSend from '../components/QuickSend.astro';
import { sendInvitation } from '../data/invitations';
import { guideImage } from '../data/images';
import { guideViews as views } from '../data/photo-guide';
---

<Base
  title="Guía de fotos"
  description="Las seis vistas de tu par y los detalles que te gusten, con las bailarinas de María como ejemplo. Con el móvil y en casa."
>
  <nav class="wrap breadcrumb" aria-label="Ruta de navegación">
    <a href="/participa/">Cómo colaborar</a>
    <span aria-hidden="true">/</span>
    <span>Guía de fotos</span>
  </nav>
  <section class="wrap page-heading">
    <span class="eyebrow print-only">El Par · Zapatos en detalle</span>
    <h1>
      Seis fotos con el móvil.
      <br />
      <em>Y los detalles que te gusten.</em>
    </h1>
    <p class="lead">
      En casa y sin complicarte. Te enseñamos cada vista con las bailarinas de María.
    </p>
    <QuickSend />
  </section>
  <div class="wrap section" style="padding-top:0">
    <section class="guide-lead" aria-labelledby="light-title">
      <div>
        <h2 id="light-title">Antes de empezar</h2>
        <p>
          Busca una luz con la que el zapato se vea bien, la que tengas, y un fondo en el que
          destaque.
        </p>
      </div>
      <ul>
        <li>Sin flash y sin filtros: que el color sea el del zapato.</li>
        <li>Que el zapato entre entero en cada vista, con un poco de aire alrededor.</li>
        <li>Sin llevarlos puestos: solo salen los zapatos.</li>
      </ul>
    </section>
    <span class="eyebrow">Las seis vistas</span>
    <div class="guide-grid">
      {views.map((view) => (
        <figure class="guide-card" id={`vista-${view.n}`}>
          <Photo
            src={guideImage(view.image)}
            alt={`${view.title}: bailarinas de María`}
            zoom
            class={view.detail ? 'detail-photo' : undefined}
            sizes="(max-width: 540px) 90vw, (max-width: 999px) 45vw, 340px"
          />
          <figcaption>
            {view.detail && <span class="guide-number">Y además, los detalles</span>}
            <h3>{view.title}</h3>
            <p>{view.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <section class="guide-checklist">
      <div>
        <h2>¿Lo tienes todo?</h2>
        <p>Un repaso rápido. Si falta algo, te lo pedimos.</p>
      </div>
      <ul>
        <li>
          Seis vistas de cada par: tres cuartos por delante, de perfil, de frente, desde arriba,
          tres cuartos por detrás y la suela.
        </li>
        <li>Los detalles que te gusten, de cerca.</li>
        <li>Si mandas varios pares, las fotos de cada uno en su bloque del formulario.</li>
      </ul>
    </section>
  </div>
  <Invitation compact content={sendInvitation} id="enviar" />
</Base>
