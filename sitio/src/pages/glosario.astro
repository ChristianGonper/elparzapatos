---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { glossary } from '../data/glossary';
import { pairs, pairPath } from '../data/pairs';
// Cada palabra enlaza con el primer par del catálogo que la usa, no siempre con el mismo.
const firstPairWith = (slug: string) => pairs.find((pair) => pair.terms.includes(slug));
---

<Base
  title="Glosario"
  description="Pala, garganta, puntera y otras palabras de los zapatos, explicadas en una o dos frases."
>
  <section class="wrap page-heading">
    <span class="eyebrow">Un detalle, un nombre</span>
    <h1>
      Para cuando quieras
      <br />
      <em>saber cómo se llama.</em>
    </h1>
    <p class="lead">En los análisis explicamos cada palabra la primera vez que sale.</p>
  </section>
  <div class="wrap glossary-layout">
    <nav class="glossary-nav" aria-label="Términos del glosario">
      <span class="eyebrow">Ir a una palabra</span>
      {glossary.map((term) => (
        <a href={`#${term.slug}`}>{term.name}</a>
      ))}
    </nav>
    <div class="glossary-list">
      {glossary.map((term) => {
        const example = firstPairWith(term.slug);
        return (
          <section id={term.slug} aria-labelledby={`heading-${term.slug}`}>
            <h2 id={`heading-${term.slug}`}>{term.name}</h2>
            <p>{term.definition}</p>
            {example && (
              <a class="text-link" href={pairPath(example)}>
                Verlo en {example.title} <Arrow />
              </a>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Base>
