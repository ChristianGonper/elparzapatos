---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { glossary } from '../data/glossary';
import { pairs, pairPath } from '../data/pairs';
---

<Base
  title="Glosario"
  description="Pala, garganta, puntera y otras palabras para mirar un zapato. Definiciones breves, sin necesidad de saber de zapatería."
>
  <section class="wrap page-heading">
    <span class="eyebrow">Un detalle, un nombre</span>
    <h1>
      Para cuando quieras
      <br />
      <em>saber cómo se llama.</em>
    </h1>
    <p class="lead">
      En los análisis explicamos cada término al encontrarlo. Aquí puedes volver a su definición,
      con calma.
    </p>
  </section>
  <div class="wrap glossary-layout">
    <nav class="glossary-nav" aria-label="Términos del glosario">
      <span class="eyebrow">Ir a una palabra</span>
      {glossary.map((term) => (
        <a href={`#${term.slug}`}>{term.name}</a>
      ))}
    </nav>
    <div class="glossary-list">
      {glossary.map((term) => (
        <section id={term.slug} aria-labelledby={`heading-${term.slug}`}>
          <h2 id={`heading-${term.slug}`}>{term.name}</h2>
          <p>{term.definition}</p>
          {pairs.some((pair) => pair.terms.includes(term.slug)) && (
            <a class="text-link" href={pairPath(pairs[0])}>
              Verlo en las bailarinas de María <Arrow />
            </a>
          )}
        </section>
      ))}
    </div>
  </div>
</Base>
