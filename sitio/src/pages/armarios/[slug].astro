---
import Base from '../../layouts/Base.astro';
import PairCard from '../../components/PairCard.astro';
import Arrow from '../../components/Arrow.astro';
import Invitation from '../../components/Invitation.astro';
import ShareLink from '../../components/ShareLink.astro';
import { pairImage } from '../../data/images';
import { wardrobes, type Wardrobe } from '../../data/wardrobes';
export function getStaticPaths() {
  return wardrobes.map((wardrobe) => ({ params: { slug: wardrobe.slug }, props: { wardrobe } }));
}
interface Props {
  wardrobe: Wardrobe;
}
const { wardrobe } = Astro.props;
// Si la colaboradora es anónima, la frase no lleva su número: «Los 3 pares que han compartido…».
const sharedBy = wardrobe.anonymous ? 'han compartido' : `${wardrobe.name} ha compartido`;
---

<Base
  title={`Armario de ${wardrobe.name}`}
  description={`Los ${wardrobe.pairs.length} pares que ${sharedBy} con El Par, juntos y mirados de cerca.`}
  image={`${pairImage(wardrobe.pairs[0], wardrobe.pairs[0].hero)}-1600.webp`}
>
  <nav class="wrap breadcrumb" aria-label="Ruta de navegación">
    <a href="/armarios/">Armarios</a>
    <span aria-hidden="true">/</span>
    <span>{wardrobe.name}</span>
  </nav>
  <section class="wrap page-heading">
    <span class="eyebrow">{wardrobe.pairs.length} pares</span>
    <h1>
      Armario de
      <br />
      <em>{wardrobe.name}.</em>
    </h1>
    <ShareLink title={`Armario de ${wardrobe.name} · El Par`} kind="armario" />
  </section>
  <div class="wrap pair-index wardrobe-pairs">
    {wardrobe.pairs.map((pair) => (
      <PairCard {pair} sizes="(max-width: 700px) 90vw, (max-width: 999px) 45vw, 30vw" />
    ))}
  </div>
  <div class="wrap wardrobe-back">
    <a class="text-link" href="/pares/">
      Ver todos los pares <Arrow />
    </a>
  </div>
  <Invitation compact />
</Base>
