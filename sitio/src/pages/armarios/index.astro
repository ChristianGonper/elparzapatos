---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import Invitation from '../../components/Invitation.astro';
import { wardrobes, wardrobePath } from '../../data/wardrobes';
import { pairImage } from '../../data/images';
---

<Base
  title="Armarios"
  description="Cuando una colaboradora nos enseña dos pares o más, los reunimos en su armario. Aquí están todos."
>
  <section class="wrap page-heading">
    <span class="eyebrow">Un armario creado entre todas</span>
    <h1>
      Un par dice mucho.
      <br />
      <em>Varios dicen quién los eligió.</em>
    </h1>
    <p class="lead">
      Cuando una colaboradora nos enseña dos pares o más, los juntamos en su armario.
    </p>
  </section>
  <div class="wrap wardrobe-index">
    {wardrobes.length ? (
      wardrobes.map((wardrobe) => {
        // Se ven dos pares; si hay más, asoman detrás del segundo (hasta dos) con un «+N».
        const [first, second, ...more] = wardrobe.pairs;
        const behind = more.slice(0, 2);
        return (
          <a class="wardrobe-card" href={wardrobePath(wardrobe)}>
            <div class="wardrobe-pictures">
              <Photo
                src={pairImage(first, first.hero)}
                alt={first.photoAlt}
                sizes="(max-width: 700px) 45vw, 30vw"
              />
              <div class="wardrobe-stack" data-behind={behind.length}>
                {behind
                  .map((pair, index) => (
                    <Photo
                      src={pairImage(pair, pair.hero)}
                      alt=""
                      class={`wardrobe-behind wardrobe-behind-${index + 1}`}
                      sizes="(max-width: 700px) 45vw, 30vw"
                    />
                  ))
                  .reverse()}
                <Photo
                  src={pairImage(second, second.hero)}
                  alt={second.photoAlt}
                  sizes="(max-width: 700px) 45vw, 30vw"
                />
                {more.length > 0 && (
                  <span class="wardrobe-more" aria-hidden="true">
                    +{more.length} {more.length === 1 ? 'par' : 'pares'}
                  </span>
                )}
              </div>
            </div>
            <div class="wardrobe-card-title">
              <div>
                <span class="eyebrow">{wardrobe.pairs.length} pares</span>
                <h2>Armario de {wardrobe.name}</h2>
              </div>
              <span class="wardrobe-open">
                Ver el armario <Arrow />
              </span>
            </div>
          </a>
        );
      })
    ) : (
      <div class="wardrobe-empty">
        <h2>
          Los primeros armarios
          <br />
          <em>están por llegar.</em>
        </h2>
        <p>Cuando una colaboradora tenga dos pares publicados, su armario aparecerá aquí.</p>
        <a class="text-link" href="/pares/">
          Ver los pares <Arrow />
        </a>
      </div>
    )}
  </div>
  <Invitation compact />
</Base>
