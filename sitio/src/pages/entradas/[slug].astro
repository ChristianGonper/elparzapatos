---
/**
 * [slug].astro — Monografía Dinámica Editorial de El Par
 * Superficie que rige: sitio/specs/monografia/spec.md
 * Especificación de migración: sitio/specs/migracion-astro/spec.md (§3.5.2)
 * Plan de migración: sitio/specs/migracion-astro/plan.md (§1.8)
 * Sistema visual y tokens: sitio/DESIGN.md y sitio/src/styles/tokens.css
 */

import type { ImageMetadata } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import LayoutMonografia from '../../layouts/LayoutMonografia.astro';
import Abstract from '../../components/Abstract.astro';
import SpecimenFrame from '../../components/SpecimenFrame.astro';
import ModuloEditorial from '../../components/ModuloEditorial.astro';
import Diptico from '../../components/Diptico.astro';
import CitaColaboradora from '../../components/CitaColaboradora.astro';
import CedulaMuseo from '../../components/CedulaMuseo.astro';
import GlossaryPopover from '../../components/GlossaryPopover.astro';

// Generación estática de rutas desde la colección tipada 'pares'
export async function getStaticPaths() {
  const pares = await getCollection('pares');
  return pares.map((par) => ({
    params: { slug: par.id },
    props: { par },
  }));
}

export interface Props {
  par: CollectionEntry<'pares'>;
}

const { par } = Astro.props;

// Pipeline tipado de activos fotográficos de la colección
const todasLasImagenes = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pares/**/*.webp',
  { eager: true }
);

function getFoto(slug: string, filename: string): ImageMetadata {
  const rutaDirecta = `/src/assets/pares/${slug}/${filename}`;
  const moduloDirecto = todasLasImagenes[rutaDirecta];
  if (moduloDirecto?.default) {
    return moduloDirecto.default;
  }
  const coincidencia = Object.entries(todasLasImagenes).find(
    ([ruta]) => ruta.includes(slug) && ruta.endsWith(filename)
  );
  if (coincidencia) {
    return coincidencia[1].default;
  }
  throw new Error(`Fotografía no encontrada para el espécimen "${slug}": ${filename}`);
}

// Activos fotográficos optimizados para las perspectivas canónicas
const fotoHero = par.data.heroImagen || getFoto(par.id, '02-tres-cuartos.webp');
const fotoPerfil = getFoto(par.id, '01-perfil.webp');
const fotoTalon = getFoto(par.id, '04-talon.webp');
const fotoFrente = getFoto(par.id, '03-frente.webp');
const fotoPlanta = getFoto(par.id, '05-planta.webp');

const currentMonografiaPath = `/entradas/${par.id}`;
---

<LayoutMonografia
  titulo={par.data.titulo}
  subtitulo={par.data.subtitulo}
  armario={par.data.cedula.procedenciaArmario}
  fechaPublicacion={par.data.fechaPublicacion}
  currentPath={currentMonografiaPath}
  ogImage={par.data.heroImagen.src}
>
  <!-- 1. CABECERA DEL ESTUDIO Y METADATOS OBSERVACIONALES -->
  <header class="estudio-cabecera">
    <div class="estudio-meta">
      <span class="estudio-armario">
        {par.data.cedula.procedenciaArmario}
        {par.data.cedula.procedenciaInstagram && (
          <span class="estudio-canal">
            (@{par.data.cedula.procedenciaInstagram.replace(/^@/, '')})
          </span>
        )}
      </span>
    </div>

    <h1 class="estudio-titulo">{par.data.titulo}</h1>

    <p class="estudio-subtitulo">{par.data.subtitulo}</p>
  </header>

  <!-- 2. ABSTRACT EDITORIAL A DOS COLUMNAS (PLIEGO DE ARTE) -->
  <section class="estudio-abstract" aria-label="Abstract editorial de apertura">
    <Abstract>
      <Fragment slot="col1">
        <p>
          La radicalidad del salón de aguja no reside en el artificio, sino en la supresión. Al prescindir de todo tipo de sujeción auxiliar, la superficie de la <GlossaryPopover termino="pala" traduccionEn="Vamp" definicion="Pieza delantera del corte que cubre los dedos y el empeine hasta la línea de garganta; determina la flexión anterior del pie al caminar." /> soporta la totalidad del empuje longitudinal al caminar.
        </p>
      </Fragment>
      <Fragment slot="col2">
        <p>
          Construido sobre la verticalidad implacable de un tacón de noventa milímetros, la tensión tensada a lo largo del arco del <GlossaryPopover termino="enfranque" traduccionEn="Waist" definicion="Zona estrechada del zapato en planta situada bajo el arco del pie, entre la planta delantera y el tacón." /> y el trazo asimétrico de su garganta, este diseño reduce la anatomía a una sola línea ininterrumpida de fuerza.
        </p>
      </Fragment>
    </Abstract>
  </section>

  <!-- 3. HERO SPECIMEN FOTOGRÁFICO (ESCALA EQUILIBRADA Y PASPARTÚ) -->
  <section class="estudio-hero" aria-label="Fotografía principal del espécimen">
    <div class="hero-frame-wrapper">
      <SpecimenFrame
        image={fotoHero}
        alt={par.data.heroAlt}
        aspectRatio="16:10"
        caption="Perspectiva tres cuartos"
        subcaption="Lámina de apertura · Escala moderada"
        triggerLightbox={true}
      />
    </div>
  </section>

  <!-- 4. PASEO VISUAL MODULAR (RETÍCULA FLEXIBLE Y LAS 3 PROPORCIONES DE PLIEGO) -->
  <div class="paseo-visual">
    <!-- Módulo 1 (7:5): La pala y el escote -->
    <ModuloEditorial
      grid="7:5"
      moduloNumero="01"
      supratitulo="[ La pala y el escote ]"
      titulo="Escote asimétrico y memoria de tensión"
      notaEditorial={{
        titulo: 'Nota editorial · La línea del escote',
        texto: 'El salón So Kate prolonga el escote hacia el nacimiento de los dedos para elongar visualmente el empeine. Este rasgo constructivo traslada el esfuerzo de retención hacia los laterales de la pala.',
      }}
    >
      <Fragment slot="texto">
        <p>
          Al prescindir de todo tipo de sujeción auxiliar, la superficie de la <GlossaryPopover termino="pala" traduccionEn="Vamp" definicion="Pieza delantera del corte que cubre los dedos y el empeine hasta la línea de garganta; determina la flexión anterior del pie al caminar." /> soporta la totalidad del apoyo al dar el paso. En este modelo, el trazo adopta un escote levemente asimétrico que se abre hacia el lateral interno con una curva suave, acompañando el empeine sin apretar.
        </p>
        <p>
          El juego de proporciones de la puntera afilada no responde únicamente a un dictado visual: proyecta una prolongación óptica que aligera el volumen del calzado en el plano horizontal, mientras que el cuero vacuno tratado al cromo mantiene la memoria de tensión sin ceder en los flancos laterales.
        </p>
      </Fragment>

      <SpecimenFrame
        slot="media"
        image={fotoPerfil}
        alt="Vista lateral del salón de aguja"
        aspectRatio="4:3"
        caption="Perfil exterior"
        subcaption="Línea de escote y tensión"
        triggerLightbox={true}
      />
    </ModuloEditorial>

    <!-- Módulo 2 (5:7): El fuste y el aplomo -->
    <ModuloEditorial
      grid="5:7"
      moduloNumero="02"
      supratitulo="[ El fuste y el aplomo ]"
      titulo="Fuste vertical de 90 mm y apoyo dorsal"
      cotaMetrica="Altura neta: 90 mm · Inclinación dorsal: 87°"
    >
      <Fragment slot="texto">
        <p>
          La costura dorsal sella la verticalidad del <GlossaryPopover termino="contrafuerte" traduccionEn="Counter" definicion="Refuerzo rígido oculto en el talón entre el corte exterior y el forro que estabiliza el calcáneo e impide el deslizamiento lateral del talón." />, asegurando el talón sin hebillas.
        </p>
        <p>
          El <GlossaryPopover termino="fuste" traduccionEn="Stem" definicion="Columna vertical del tacón comprendida entre la base superior de asiento y la tapa de apoyo; su silueta y perfil definen el tipo de tacón." /> canaliza noventa milímetros de carga perpendicular hacia una microtapa reforzada. Un equilibrio milimétrico que sostiene la arquitectura sin vacilación postural.
        </p>
      </Fragment>

      <SpecimenFrame
        slot="media"
        image={fotoTalon}
        alt="Vista posterior del talón y aplomo del tacón aguja"
        aspectRatio="3:4"
        caption="Vista posterior"
        subcaption="Aplomo de 90 mm"
        triggerLightbox={true}
      />
    </ModuloEditorial>

    <!-- Módulo 3 (6:6): El enfranque y el puente -->
    <ModuloEditorial
      grid="6:6"
      moduloNumero="03"
      supratitulo="[ El enfranque y el puente ]"
      titulo="El arco del enfranque y la curvatura del puente"
      invertir={true}
    >
      <Fragment slot="texto">
        <p>
          Bajo la concavidad del arco plantar, el <GlossaryPopover termino="enfranque" traduccionEn="Waist" definicion="Zona estrechada del zapato en planta situada bajo el arco del pie, entre la planta delantera y el tacón." /> experimenta la máxima compresión estructural. Es el puente invisible del calzado: debe sostener el arco natural sin ceder, transfiriendo de forma progresiva el impulso hacia la almohadilla delantera.
        </p>
        <p>
          Asimismo, la garganta describe una caída de 45 mm respecto al borde superior del contrafuerte. Esta inflexión expone limpiamente la silueta del empeine y exige una rigidez milimétrica en el <GlossaryPopover termino="cambrillón" traduccionEn="Shank" definicion="Refuerzo longitudinal rígido (de acero, madera o fibra) alojado en el enfranque que sostiene el arco óseo del pie e impide que el zapato parta por la mitad." /> para asegurar la firmeza de la pisada.
        </p>
      </Fragment>

      <SpecimenFrame
        slot="media"
        image={fotoPerfil}
        alt="Perfil del enfranque y curvatura del arco"
        aspectRatio="4:3"
        caption="Perfil del enfranque"
        subcaption="Curvatura del arco longitudinal"
        triggerLightbox={true}
      />
    </ModuloEditorial>

    <!-- Módulo 4: Díptico Morfológico -->
    <article class="modulo-diptico-seccion" aria-label="Díptico morfológico de puntera y planta">
      <div class="diptico-intro">
        <div class="diptico-header-tag">
          <span class="diptico-modulo-num">· 04</span>
          <span class="diptico-divisor" aria-hidden="true">|</span>
          <span class="diptico-supratitulo">[ Geometría de puntera y planta ]</span>
        </div>
        <h2 class="diptico-titulo">Geometría de la puntera y el plano de contacto</h2>
        <p class="diptico-descripcion">
          La vista frontal y la planta revelan la convergencia extrema del diseño: un área de pisada reducida al mínimo indispensable y una agudeza triangular que modela el volumen de la puntera en relación directa con el suelo.
        </p>
      </div>

      <Diptico
        imagenes={[
          {
            image: fotoFrente,
            alt: 'Vista frontal y cenital de la puntera afilada',
            label: '01. Frontal',
            sublabel: 'Puntera afilada',
          },
          {
            image: fotoPlanta,
            alt: 'Vista inferior de la suela y plano de apoyo',
            label: '02. Planta',
            sublabel: 'Suela y huella',
          },
        ]}
        titulo="Díptico Morfológico · Observación Simultánea Frontal / Huella"
        ejeMorfologico="Convergencia de puntera cónica (frontal) y área de contacto mínima (planta)"
        pieCentrado="El encuentro entre el perfil afilado de la puntera y la distribución de contacto de la suela comprime el área de apoyo a menos de 28 cm² en el antepié, transformando cada pisada en una articulación de precisión percutiva."
        aspectRatio="1:1"
        triggerLightbox={true}
      />
    </article>
  </div>

  <!-- 5. TESTIMONIO DE LA DUEÑA (CONDICIONAL) -->
  {par.data.testimonio && (
    <section class="estudio-testimonio" aria-label={`Testimonio de ${par.data.testimonio.autora}`}>
      <div class="testimonio-wrapper">
        <CitaColaboradora
          texto={par.data.testimonio.texto}
          autora={par.data.testimonio.autora}
          posicion={par.data.testimonio.posicion}
        />
      </div>
    </section>
  )}

  <!-- 6. CÉDULA TÉCNICA DE MUSEO (VARIANTE 3A APROBADA) -->
  <section class="estudio-cedula" aria-label="Cédula técnica del espécimen">
    <CedulaMuseo cedula={par.data.cedula} />
  </section>
</LayoutMonografia>

<style>
  /* ==========================================================================
     CABECERA DEL ESTUDIO Y APERTURA
     Tipografía Newsreader serif carbón (#1C1A18) y metadatos cognac (#9E6B55).
     ========================================================================== */
  .estudio-cabecera {
    max-width: 48rem;
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .estudio-meta {
    margin-bottom: var(--space-4);
  }

  .estudio-armario {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    color: var(--color-cognac);
    font-weight: 500;
  }

  .estudio-canal {
    color: var(--color-graphite);
    font-weight: normal;
  }

  .estudio-titulo {
    margin: 0 0 var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: normal;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight, 1.15);
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .estudio-titulo {
      font-size: var(--text-5xl);
    }
  }

  @media (min-width: 768px) {
    .estudio-titulo {
      font-size: 3.75rem; /* 60px */
    }
  }

  .estudio-subtitulo {
    margin: 0 auto;
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed, 1.625);
    color: var(--color-graphite);
  }

  @media (min-width: 640px) {
    .estudio-subtitulo {
      font-size: var(--text-lg);
    }
  }

  /* ==========================================================================
     ABSTRACT EDITORIAL
     ========================================================================== */
  .estudio-abstract {
    margin-bottom: var(--space-14);
  }

  /* ==========================================================================
     HERO SPECIMEN (LÁMINA DE APERTURA)
     ========================================================================== */
  .estudio-hero {
    margin-bottom: var(--space-20);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-hairline);
  }

  .hero-frame-wrapper {
    max-width: 56rem; /* 896px centrado */
    margin: 0 auto;
  }

  /* ==========================================================================
     PASEO VISUAL MODULAR (ESPACIADO REPOSADO)
     ========================================================================== */
  .paseo-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    margin-bottom: var(--space-24);
  }

  @media (min-width: 768px) {
    .paseo-visual {
      gap: var(--space-32);
      margin-bottom: var(--space-32);
    }
  }

  /* ==========================================================================
     MÓDULO DÍPTICO (SECCIÓN CONTINUA)
     ========================================================================== */
  .modulo-diptico-seccion {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .diptico-intro {
    max-width: 44rem;
    margin: 0 auto var(--space-10);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .diptico-header-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: var(--tracking-mono-wide, 0.12em);
    text-transform: uppercase;
    font-weight: 500;
  }

  .diptico-modulo-num {
    color: var(--color-graphite);
    font-weight: normal;
  }

  .diptico-divisor {
    color: var(--color-hairline);
    user-select: none;
  }

  .diptico-supratitulo {
    color: var(--color-cognac);
  }

  .diptico-titulo {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: normal;
    line-height: var(--leading-tight, 1.15);
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .diptico-titulo {
      font-size: var(--text-4xl);
    }
  }

  .diptico-descripcion {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: var(--leading-prose, 1.75);
    color: var(--color-graphite);
  }

  /* ==========================================================================
     TESTIMONIO DE COLABORADORA
     ========================================================================== */
  .estudio-testimonio {
    max-width: 48rem;
    margin: 0 auto var(--space-16);
  }

  .testimonio-wrapper {
    width: 100%;
  }

  /* ==========================================================================
     CÉDULA TÉCNICA DE MUSEO
     ========================================================================== */
  .estudio-cedula {
    margin-bottom: var(--space-16);
  }

  /* ==========================================================================
     RESPONSIVE MÓVIL (< 768px)
     ========================================================================== */
  @media (max-width: 767px) {
    .estudio-cabecera {
      margin-bottom: var(--space-8);
    }

    .estudio-abstract {
      margin-bottom: var(--space-10);
    }

    .estudio-hero {
      margin-bottom: var(--space-14);
      padding-bottom: var(--space-10);
    }

    .paseo-visual {
      gap: var(--space-16);
      margin-bottom: var(--space-16);
    }

    .diptico-intro {
      margin-bottom: var(--space-6);
    }

    .estudio-testimonio {
      margin-bottom: var(--space-10);
    }

    .estudio-cedula {
      margin-bottom: var(--space-10);
    }
  }
</style>
