---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import Invitation from '../components/Invitation.astro';
import { pairs, mariaImage, pairPath } from '../data/pairs';
import { wardrobes, wardrobePath } from '../data/wardrobes';
import { pairImage } from '../data/pairs';
import { site } from '../data/site';
const featured = pairs[0];
const looks = [
  {
    base: '/imagenes/ejemplos/marrones_2',
    title: 'Un tacón que cambia la silueta',
    text: 'De frente mandan las tiras. De lado, la forma del tacón.',
    label: 'La forma',
  },
  {
    base: '/imagenes/ejemplos/negras_1',
    title: 'El detalle que se lleva la mirada',
    text: 'Tres círculos sobre las tiras, con relieves que se ven al acercarse.',
    label: 'El detalle',
  },
  {
    base: '/imagenes/ejemplos/alpargata_tacon_1',
    title: 'Más que una puntera cerrada',
    text: 'La base, el talón abierto y una tira alrededor del tobillo.',
    label: 'El conjunto',
  },
];
---

<Base
  title="El Par"
  description="Vuelve a mirar tus zapatos. Descubre los detalles de cada par y participa con fotos de los tuyos."
>
  <section class="home-intro wrap">
    <div>
      <span class="eyebrow">Zapatos en detalle</span>
      <h1>
        Vuelve a mirar
        <br />
        <em>tus zapatos.</em>
      </h1>
    </div>
    <div class="intro-copy">
      <p>
        Una puntera, una tira, un pequeño brillo. Hay detalles que cambian un zapato entero. En El
        Par nos acercamos para enseñártelos.
      </p>
      <a class="button" href={site.tally}>
        Enviar mis fotos <Arrow />
      </a>
      <p class="small-note">Nos envías fotos, no los zapatos.</p>
    </div>
  </section>
  <section class="home-feature" aria-labelledby="feature-title">
    <a
      class="home-feature-photo"
      href={pairPath(featured)}
      aria-label={`Leer a fondo: ${featured.title}`}
    >
      <Photo
        base={mariaImage(featured.hero)}
        alt="Las bailarinas de María, con rejilla oscura, flores y pequeños brillos"
        priority
        sizes="(max-width: 800px) 92vw, 60vw"
      />
    </a>
    <div class="home-feature-copy">
      <div class="feature-meta">
        <span>Bajo lupa</span>
        <span>01 / Bailarinas</span>
      </div>
      <h2 id="feature-title">
        Flores sobre
        <br />
        <em>una rejilla.</em>
      </h2>
      <p>{featured.teaser}</p>
      <a class="text-link" href={pairPath(featured)}>
        Leer a fondo <Arrow />
      </a>
    </div>
  </section>
  <div class="wrap feature-footnote">
    <span>Un par compartido por María</span>
    <a href="/pares/">
      Ver los pares <Arrow />
    </a>
  </div>
  <section class="wrap section">
    <div class="editorial-intro">
      <div>
        <span class="eyebrow">Siempre hay algo que mirar</span>
        <h2>
          Lo que te gusta.
          <br />
          <em>Y lo que aún no has visto.</em>
        </h2>
      </div>
      <div class="copy">
        <p class="lead">
          No hace falta saber de zapatos para fijarte en ellos. Miramos la forma, seguimos una línea
          y nos acercamos a ese detalle que te hizo elegirlos.
        </p>
        <a class="text-link" href="/el-par/">
          Qué es El Par <Arrow />
        </a>
      </div>
    </div>
    <div class="look-row">
      {looks.map((look) => (
        <article class="look-card">
          <Photo
            base={look.base}
            alt={look.title}
            max={960}
            width={960}
            height={1280}
            sizes="(max-width: 540px) 45vw, 30vw"
          />
          <div>
            <span class="eyebrow">{look.label}</span>
            <h3>{look.title}</h3>
            <p>{look.text}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="look-note">
      Algunos ejemplos de lo que podemos mirar juntos. La marca y el precio no deciden qué tiene un
      zapato que contar.
    </p>
  </section>
  {wardrobes[0] && (
    <section class="wrap section home-wardrobe">
      <div>
        <span class="eyebrow">Dos pares, otra forma de descubrir</span>
        <h2>
          El armario
          <br />
          <em>empieza contigo.</em>
        </h2>
        <p class="lead">
          María nos ha enseñado dos bailarinas. Una deja ver a través de sus flores; la otra lleva
          manchas por toda la superficie. Las reunimos en su armario.
        </p>
        <a class="text-link" href={wardrobePath(wardrobes[0])}>
          Entrar en el Armario de María <Arrow />
        </a>
      </div>
      <a
        class="wardrobe-pictures"
        href={wardrobePath(wardrobes[0])}
        aria-label="Ver los dos pares del Armario de María"
      >
        {wardrobes[0].pairs.map((pair) => (
          <Photo
            base={pairImage(pair, pair.hero)}
            alt={pair.photoAlt}
            sizes="(max-width: 800px) 45vw, 25vw"
          />
        ))}
      </a>
    </section>
  )}
  <Invitation />
</Base>
