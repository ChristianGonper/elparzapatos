---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import Invitation from '../components/Invitation.astro';
import { featuredPair, pairPath } from '../data/pairs';
import { wardrobes, wardrobePath } from '../data/wardrobes';
import { pairImage } from '../data/images';
const featured = featuredPair;
const looks = [
  {
    base: '/imagenes/ejemplos/marrones_2',
    title: 'Un tacón que cambia la silueta',
    text: 'De frente mandan las tiras. De lado, la forma del tacón.',
    label: 'La forma',
  },
  {
    base: '/imagenes/ejemplos/negras_1',
    title: 'El detalle que se lleva la mirada',
    text: 'Tres círculos sobre las tiras, con relieves que se ven al acercarse.',
    label: 'El detalle',
  },
  {
    base: '/imagenes/ejemplos/alpargata_tacon_1',
    title: 'Más que una puntera cerrada',
    text: 'La base, el talón abierto y una tira alrededor del tobillo.',
    label: 'El conjunto',
  },
];
---

<Base
  title="El Par"
  description="Vuelve a mirar tus zapatos. Descubre los detalles de cada par y participa con fotos de los tuyos."
>
  {featured && (
    <>
      <section class="home-feature" aria-labelledby="feature-title">
        <a
          class="home-feature-photo"
          href={pairPath(featured)}
          aria-label={`Leer a fondo: ${featured.title}`}
        >
          <Photo
            base={pairImage(featured, featured.hero)}
            alt={featured.photoAlt}
            priority
            sizes="(max-width: 800px) 92vw, 60vw"
          />
        </a>
        <div class="home-feature-copy">
          <div class="feature-meta">
            <span>Bajo lupa</span>
            <span>
              {featured.status === 'published' ? 'Último publicado' : 'En revisión'} ·{' '}
              {featured.type}
            </span>
          </div>
          <h1 id="feature-title">
            <em>{featured.title}</em>
          </h1>
          <p>{featured.teaser}</p>
          <a class="text-link" href={pairPath(featured)}>
            Leer a fondo <Arrow />
          </a>
        </div>
      </section>
      <div class="wrap feature-footnote">
        <span>Un par compartido por {featured.credit}</span>
        <a href="/pares/">
          Ver los pares <Arrow />
        </a>
      </div>
    </>
  )}
  <section class="home-intro wrap">
    <div>
      {featured ? (
        <h2>
          Vuelve a mirar <em>tus zapatos.</em>
        </h2>
      ) : (
        <h1>
          Vuelve a mirar <em>tus zapatos.</em>
        </h1>
      )}
    </div>
    <div class="intro-copy">
      <p>
        Nos enseñas un par tuyo y lo miramos en detalle. Revisas el análisis antes de publicarlo y
        recibes su enlace para compartirlo.
      </p>
      <a class="text-link" href="/participa/">
        Cómo colaborar <Arrow />
      </a>
    </div>
  </section>
  <section class="wrap section">
    <div class="editorial-intro">
      <div>
        <span class="eyebrow">Fotos de ejemplo · Siempre hay algo que mirar</span>
        <h2>
          Hay mucho <em>que mirar.</em>
        </h2>
      </div>
      <div class="copy">
        <p class="lead">
          Una forma, una tira, un adorno. El precio y la marca no deciden qué tiene un zapato que
          contar.
        </p>
      </div>
    </div>
    <div class="look-row">
      {looks.map((look) => (
        <figure class="look-card">
          <Photo
            base={look.base}
            alt={look.title}
            max={960}
            width={960}
            height={1280}
            sizes="(max-width: 540px) 45vw, 30vw"
          />
          <figcaption>
            <span class="eyebrow">{look.label}</span>
            <h3>{look.title}</h3>
            <p>{look.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="look-note">
      Estas fotos son ejemplos de detalles que podemos mirar juntos. Encontrarás las entradas
      completas en <a href="/pares/">Pares</a>. La marca y el precio no deciden qué tiene un zapato
      que contar.
    </p>
  </section>
  {wardrobes[0] && (
    <section class="wrap section home-wardrobe">
      <div>
        <span class="eyebrow">Los pares de cada colaboradora</span>
        <h2>
          El armario
          <br />
          <em>empieza contigo.</em>
        </h2>
        <p class="lead">
          Con un par tienes su análisis en Pares. Desde el segundo, los reunimos también en tu
          armario, que crece con cada nuevo par que compartes.
        </p>
        <a class="text-link" href={wardrobePath(wardrobes[0])}>
          Entrar en el Armario de {wardrobes[0].name} <Arrow />
        </a>
      </div>
      <a
        class="wardrobe-pictures"
        href={wardrobePath(wardrobes[0])}
        aria-label={`Ver los pares del Armario de ${wardrobes[0].name}`}
      >
        {wardrobes[0].pairs.slice(0, 2).map((pair) => (
          <Photo
            base={pairImage(pair, pair.hero)}
            alt={pair.photoAlt}
            sizes="(max-width: 800px) 45vw, 25vw"
          />
        ))}
      </a>
    </section>
  )}
  <Invitation />
</Base>
