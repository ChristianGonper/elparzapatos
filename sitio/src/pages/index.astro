---
/**
 * index.astro — Portada de la Colección de El Par
 * Superficie que rige: sitio/specs/portada/spec.md
 * Especificación de migración: sitio/specs/migracion-astro/spec.md (§3.5.1)
 * Sistema visual y tokens: sitio/DESIGN.md y sitio/src/styles/tokens.css
 */

import LayoutBase from '../layouts/LayoutBase.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Consulta de entregas de la colección 'pares'
const todasLasEntregas = await getCollection('pares');

// Orden cronológico descendente por fecha formal de publicación
const paresOrdenados = todasLasEntregas.sort(
  (a, b) => b.data.fechaPublicacion.getTime() - a.data.fechaPublicacion.getTime()
);

// Identificación de la pieza destacada (Hero Piece): la marcada con destacadoEnPortada o la más reciente
const piezaDestacada =
  paresOrdenados.find((p) => p.data.destacadoEnPortada) || paresOrdenados[0];

// Entregas secundarias para la cuadrícula de colección (excluyendo la pieza destacada)
const paresColeccion = piezaDestacada
  ? paresOrdenados.filter((p) => p.id !== piezaDestacada.id)
  : [];

// Regla de arranque inaugural (ADR-POR-01):
// Con 1 sola entrega en el archivo, la portada muestra la Pieza Destacada y pasa directamente
// al bloque de cierre "Comparte un par", sin duplicar la pieza ni mostrar rejillas vacías.
const hayColeccion = paresColeccion.length > 0;
---

<LayoutBase
  title="El Par — Zapatos en detalle | Colección y Monografías Editoriales"
  currentPath="/"
>
  <Header currentPath="/" />

  <main class="portada-main">
    <!-- 1. PIEZA DESTACADA (HERO PIECE) -->
    {piezaDestacada && (
      <section class="hero-section" aria-label="Pieza destacada de la colección">
        <div class="hero-card">
          <!-- Columna izquierda en escritorio / Superior en móvil: Marco fotográfico del espécimen -->
          <div class="hero-visual">
            <div
              class="specimen-frame"
              tabindex="0"
              role="button"
              aria-label={`Inspeccionar espécimen: ${piezaDestacada.data.heroAlt}`}
              data-lightbox-trigger=""
              data-lightbox-src={piezaDestacada.data.heroImagen.src}
              data-lightbox-alt={piezaDestacada.data.heroAlt}
              data-lightbox-caption={piezaDestacada.data.heroAlt}
            >
              <div class="specimen-mat">
                <Image
                  src={piezaDestacada.data.heroImagen}
                  alt={piezaDestacada.data.heroAlt}
                  class="specimen-image"
                  loading="eager"
                />
              </div>
            </div>
          </div>

          <!-- Columna derecha en escritorio / Inferior en móvil: Bloque editorial interactivo hacia el estudio -->
          <a
            href={`/entradas/${piezaDestacada.id}`}
            class="hero-editorial-link"
            aria-label={`Ver estudio monográfico: ${piezaDestacada.data.titulo}`}
          >
            <div class="hero-editorial">
              <div class="editorial-body">
                <div class="hero-meta">
                  <span class="meta-badge">Pieza Destacada</span>
                  <span class="meta-origin">{piezaDestacada.data.cedula.procedenciaArmario}</span>
                </div>

                <h1 class="hero-title">{piezaDestacada.data.titulo}</h1>

                <p class="hero-subtitle">{piezaDestacada.data.subtitulo}</p>
              </div>

              <!-- Silencio editorial: sin párrafos de relleno. Acción sobria hacia el estudio monográfico -->
              <div class="editorial-action">
                <span class="hero-action-link">
                  <span>Ver estudio</span>
                  <span class="action-arrow" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Ancla de navegación canónica para el enlace 'Colección' del Header/Footer -->
    <div id="coleccion" class="coleccion-anchor"></div>

    <!-- 2. CUADRÍCULA DE COLECCIÓN (Visible únicamente con 2 o más entregas catalogadas) -->
    {hayColeccion && (
      <section class="coleccion-section" aria-label="Colección de calzado">
        <div class="coleccion-grid">
          {paresColeccion.map((par) => (
            <article class="par-card">
              <a
                href={`/entradas/${par.id}`}
                class="par-card-link"
                aria-label={`Ver monografía de ${par.data.titulo}`}
              >
                <div class="par-card-image-wrap">
                  <Image
                    src={par.data.heroImagen}
                    alt={par.data.heroAlt}
                    class="par-card-image"
                    loading="lazy"
                  />
                </div>
                <div class="par-card-info">
                  <div class="par-card-origin">{par.data.cedula.procedenciaArmario}</div>
                  <h2 class="par-card-title">{par.data.titulo}</h2>
                  <p class="par-card-subtitle">{par.data.subtitulo}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 3. CIERRE COLABORATIVO: COMPARTE UN PAR -->
    <section id="comparte" class="comparte-section" aria-label="Comparte un par con El Par">
      <div class="comparte-card">
        <div class="comparte-content">
          <span class="comparte-badge">Comparte un par</span>
          <p class="comparte-text">
            Una colección construida desde la cercanía. Si tienes algún par con detalles especiales, una silueta particular o un diseño que merezca verse de cerca, puedes proponérnoslo para formar parte de la publicación.
          </p>
        </div>
        <div class="comparte-action">
          <a
            href="/como-colaborar"
            class="comparte-link"
            title="Conoce cómo colaborar con El Par"
          >
            <span>Cómo colaborar</span>
            <span class="action-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath="/" hideColaborarLink={true} />
</LayoutBase>

<style>
  /* ==========================================================================
     PORTADA EDITORIAL — CONTENEDOR Y DISPOSICIÓN PRINCIPAL
     ========================================================================== */
  .portada-main {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
    width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .portada-main {
      padding: 0 var(--space-4);
    }
  }

  .coleccion-anchor {
    position: relative;
    top: -2rem;
    height: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* ==========================================================================
     1. PIEZA DESTACADA (HERO PIECE)
     Composición en 2 columnas en escritorio (fotografía izquierda, texto derecha).
     Apilado vertical en móvil (fotografía primero, texto después).
     Aristas vivas (border-radius: 0), fondo Specimen White y filetes hairline.
     ========================================================================== */
  .hero-section {
    padding: var(--space-12) 0 var(--space-16);
  }

  @media (max-width: 767px) {
    .hero-section {
      padding: var(--space-6) 0 var(--space-10);
    }
  }

  .hero-card {
    background-color: var(--color-specimen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-card {
      grid-template-columns: 7fr 5fr;
    }
  }

  /* Marco Fotográfico de Espécimen con Paspartú */
  .hero-visual {
    background-color: color-mix(in srgb, var(--color-linen) 40%, var(--color-paper));
    padding: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-hairline);
  }

  @media (min-width: 768px) {
    .hero-visual {
      padding: var(--space-12);
    }
  }

  @media (min-width: 1024px) {
    .hero-visual {
      border-bottom: none;
      border-right: 1px solid var(--color-hairline);
    }
  }

  .specimen-frame {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 1 / 1;
    background-color: var(--color-specimen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
    outline: none;
    box-sizing: border-box;
    transition:
      border-color var(--transition-serene),
      box-shadow var(--transition-serene);
  }

  @media (min-width: 768px) {
    .specimen-frame {
      padding: var(--space-8);
    }
  }

  /* Paspartú interior troquelado con esquinas redondeadas */
  .specimen-frame::after {
    content: '';
    position: absolute;
    top: 7px;
    left: 7px;
    right: 7px;
    bottom: 7px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    pointer-events: none;
    transition:
      border-color var(--transition-serene),
      border-radius var(--transition-serene);
    z-index: 10;
  }

  /* Micro-interacción de inspección serena en hover y foco accesible */
  .specimen-frame:hover,
  .specimen-frame:focus-visible,
  .specimen-frame:focus {
    border-color: var(--color-cognac);
    box-shadow: inset 0 0 0 8px var(--color-paper);
  }

  .specimen-frame:hover::after,
  .specimen-frame:focus-visible::after,
  .specimen-frame:focus::after {
    border-color: var(--color-cognac);
    border-radius: var(--radius-md);
  }

  .specimen-mat {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* La imagen fotográfica nunca escala ni se desplaza para no desvirtuar el espécimen */
  .specimen-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: none !important;
    transition: none !important;
    filter: none !important;
    user-select: none;
  }

  /* ==========================================================================
     Tarjeta Editorial Accionable (Puerta de Entrada Integral al Estudio)
     Toda la columna derecha es un enlace accesible con cursor pointer,
     tinte sereno de papel en hover, título en cognac y avance de flecha.
     ========================================================================== */
  .hero-editorial-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    outline: none;
    height: 100%;
    cursor: pointer;
  }

  .hero-editorial-link:focus-visible {
    outline: 2px solid var(--color-cognac);
    outline-offset: -2px;
  }

  .hero-editorial {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-specimen);
    box-sizing: border-box;
    height: 100%;
    transition: background-color var(--transition-hover);
  }

  @media (min-width: 768px) {
    .hero-editorial {
      padding: var(--space-12);
    }
  }

  .hero-editorial-link:hover .hero-editorial,
  .hero-editorial-link:focus-visible .hero-editorial {
    background-color: color-mix(in srgb, var(--color-paper) 45%, var(--color-specimen));
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    line-height: var(--leading-none);
  }

  .meta-badge {
    color: var(--color-cognac);
    font-weight: 500;
  }

  .meta-origin {
    color: var(--color-graphite);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-headline);
    letter-spacing: var(--tracking-headline);
    margin: 0 0 var(--space-4) 0;
    transition: color var(--transition-hover);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }

  .hero-editorial-link:hover .hero-title,
  .hero-editorial-link:focus-visible .hero-title {
    color: var(--color-cognac);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-graphite);
    line-height: var(--leading-normal);
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: var(--text-base);
    }
  }

  /* Acción editorial sobria */
  .editorial-action {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-hairline);
  }

  .hero-action-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--min-tap-target);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    user-select: none;
    transition: color var(--transition-hover);
  }

  .hero-editorial-link:hover .hero-action-link,
  .hero-editorial-link:focus-visible .hero-action-link {
    color: var(--color-cognac);
  }

  .hero-action-link .action-arrow {
    display: inline-block;
    transition: transform var(--transition-hover);
  }

  .hero-editorial-link:hover .action-arrow,
  .hero-editorial-link:focus-visible .action-arrow {
    transform: translateX(6px);
  }

  /* ==========================================================================
     2. CUADRÍCULA DE COLECCIÓN (2 o más entregas)
     ========================================================================== */
  .coleccion-section {
    padding-bottom: var(--space-20);
  }

  .coleccion-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .coleccion-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .coleccion-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-10);
    }
  }

  .par-card {
    background-color: var(--color-specimen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition-hover),
      box-shadow var(--transition-hover);
  }

  .par-card:hover {
    border-color: var(--color-ink);
    box-shadow: var(--shadow-subtle);
  }

  .par-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .par-card-link:focus-visible {
    outline: 2px solid var(--color-cognac);
    outline-offset: 2px;
  }

  .par-card-image-wrap {
    aspect-ratio: 1 / 1;
    background-color: color-mix(in srgb, var(--color-linen) 30%, var(--color-paper));
    border-bottom: 1px solid var(--color-hairline);
    padding: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .par-card-image-wrap {
      padding: var(--space-8);
    }
  }

  .par-card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: none !important;
    transition: none !important;
    filter: none !important;
  }

  .par-card-info {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex-grow: 1;
  }

  .par-card-origin {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-graphite);
    margin-bottom: var(--space-1);
  }

  .par-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-1) 0;
    transition: color var(--transition-hover);
  }

  .par-card-link:hover .par-card-title {
    color: var(--color-cognac);
  }

  .par-card-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-graphite);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ==========================================================================
     3. CIERRE COLABORATIVO: COMPARTE UN PAR
     Superficie Muted Linen, filete hairline y radios editoriales consistentes.
     ========================================================================== */
  .comparte-section {
    padding-bottom: var(--space-20);
  }

  .comparte-card {
    background-color: var(--color-linen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-subtle);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .comparte-card {
      padding: var(--space-12);
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-10);
    }
  }

  .comparte-content {
    max-width: 44rem;
  }

  .comparte-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    color: var(--color-cognac);
    font-weight: 500;
    display: block;
    margin-bottom: var(--space-2);
  }

  .comparte-text {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-prose);
    margin: 0;
  }

  @media (min-width: 768px) {
    .comparte-text {
      font-size: var(--text-2xl);
    }
  }

  .comparte-action {
    flex-shrink: 0;
  }

  .comparte-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--min-tap-target);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    user-select: none;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 2px;
    transition:
      color var(--transition-hover),
      border-color var(--transition-hover);
  }

  .comparte-link:hover {
    color: var(--color-cognac);
    border-color: var(--color-cognac);
  }

  .comparte-link .action-arrow {
    display: inline-block;
    transition: transform var(--transition-hover);
  }

  .comparte-link:hover .action-arrow {
    transform: translateX(4px);
  }
</style>
