---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import PairCard from '../components/PairCard.astro';
import WardrobeFan from '../components/WardrobeFan.astro';
import { featuredPair, pairPath } from '../data/pairs';
import { wardrobePath } from '../data/wardrobes';
import { pairImage } from '../data/images';
import { countLabel, homeDetails, homeWardrobes, kindSummaries, latestPairs } from '../data/home';
const featured = featuredPair;
const [onlyWardrobe] = homeWardrobes;
---

<Base
  title="El Par"
  description="Vuelve a mirar tus zapatos. Pares de nuestras colaboradoras, mirados de cerca: cada detalle con su foto y su nombre."
>
  {featured && (
    <>
      <section class="home-feature" aria-labelledby="feature-title">
        <a
          class="home-feature-photo"
          href={pairPath(featured)}
          aria-label={`Leer a fondo: ${featured.title}`}
        >
          <Photo
            src={pairImage(featured, featured.hero)}
            alt={featured.photoAlt}
            priority
            sizes="(max-width: 800px) 92vw, 60vw"
          />
        </a>
        <div class="home-feature-copy">
          <div class="feature-meta">
            <span>Bajo lupa · {featured.type}</span>
            {featured.status !== 'published' && <span>En revisión</span>}
          </div>
          <h1 id="feature-title">
            <em>{featured.title}</em>
          </h1>
          <p>{featured.teaser}</p>
          <a class="text-link" href={pairPath(featured)}>
            Leer a fondo <Arrow />
          </a>
        </div>
      </section>
    </>
  )}
  <section class="home-intro wrap">
    <div>
      {featured ? (
        <h2>
          Vuelve a mirar <em>tus zapatos.</em>
        </h2>
      ) : (
        <h1>
          Vuelve a mirar <em>tus zapatos.</em>
        </h1>
      )}
    </div>
    <div class="intro-copy">
      <p>Nos mandas fotos de un par que te encanta y te contamos todo lo que tiene.</p>
      <a class="text-link" href="/participa/">
        Cómo colaborar <Arrow />
      </a>
    </div>
  </section>
  <section class="wrap section home-details" aria-labelledby="details-title">
    <div class="editorial-intro">
      <div>
        <span class="eyebrow">En qué nos fijamos</span>
        <h2 id="details-title">
          Hay mucho <em>que mirar.</em>
        </h2>
      </div>
      <div class="copy">
        <p class="lead">
          Un borde, un color, la forma de un tacón. Ni la marca ni el precio deciden lo que un
          zapato tiene que contar.
        </p>
      </div>
    </div>
    <div class="look-row">
      {homeDetails.map((detail) => (
        <figure class="look-card">
          <Photo src={detail.image} alt={detail.title} sizes="(max-width: 540px) 45vw, 30vw" />
          <figcaption>
            <span class="eyebrow">{detail.label}</span>
            <h3>{detail.title}</h3>
            <p>{detail.text}</p>
            {detail.pair && (
              <a class="text-link" href={pairPath(detail.pair)}>
                Leer el análisis <Arrow />
              </a>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="home-more">
      <a class="button outline" href="/pares/">
        Ver todos los pares <Arrow />
      </a>
    </div>
  </section>
  {latestPairs.length > 0 && (
    <section class="wrap section home-latest" aria-labelledby="latest-title">
      <h2 id="latest-title">
        Lo último
        <br />
        <em>que hemos mirado.</em>
      </h2>
      <div class="pair-index">
        {latestPairs.map((pair) => (
          <PairCard {pair} />
        ))}
      </div>
      <div class="home-more">
        <a class="button outline" href="/pares/">
          Seguir mirando <Arrow />
        </a>
      </div>
    </section>
  )}
  {homeWardrobes.length === 1 && (
    <section class="wrap section home-wardrobe">
      <div>
        <span class="eyebrow">Armarios</span>
        <h2>
          El armario
          <br />
          <em>empieza contigo.</em>
        </h2>
        <p class="lead">
          Mándanos dos pares o más y tendrás tu armario en El Par. Así es el de {onlyWardrobe.name}.
        </p>
        <a class="text-link" href={wardrobePath(onlyWardrobe)}>
          Entrar en el Armario de {onlyWardrobe.name} <Arrow />
        </a>
      </div>
      <a
        class="wardrobe-pictures"
        href={wardrobePath(onlyWardrobe)}
        aria-label={`Ver los pares del Armario de ${onlyWardrobe.name}`}
      >
        {onlyWardrobe.pairs.slice(0, 2).map((pair) => (
          <Photo
            src={pairImage(pair, pair.hero)}
            alt={pair.photoAlt}
            sizes="(max-width: 800px) 45vw, 25vw"
          />
        ))}
      </a>
    </section>
  )}
  {homeWardrobes.length > 1 && (
    <section class="wrap section home-wardrobes" aria-labelledby="wardrobes-title">
      <div class="editorial-intro">
        <div>
          <span class="eyebrow">Armarios</span>
          <h2 id="wardrobes-title">
            El armario
            <br />
            <em>empieza contigo.</em>
          </h2>
        </div>
        <div class="copy">
          <p class="lead">Mándanos dos pares o más y tendrás tu armario en El Par.</p>
        </div>
      </div>
      <ul class="home-wardrobe-list">
        {homeWardrobes.map((wardrobe) => (
          <li>
            <a class="home-wardrobe-card" href={wardrobePath(wardrobe)}>
              <WardrobeFan {wardrobe} />
              <span class="eyebrow">{wardrobe.pairs.length} pares</span>
              <h3>Armario de {wardrobe.name}</h3>
            </a>
          </li>
        ))}
      </ul>
      <div class="home-more">
        <a class="button outline" href="/armarios/">
          Ver los armarios <Arrow />
        </a>
      </div>
    </section>
  )}
  <section class="invitation home-final" aria-labelledby="final-title">
    <div class="wrap">
      <div class="invitation-inner">
        <div>
          <span class="eyebrow">Qué zapatos contamos</span>
          <h2 id="final-title">
            ¿Nos enseñas
            <br />
            <em>tus zapatos?</em>
          </h2>
        </div>
        <div class="invitation-copy">
          <p>
            Bailarinas, salones, sandalias de tacón, cuñas, plataformas, alpargatas… Mándanos el que
            más te guste, o varios: cada uno tendrá su espacio.
          </p>
          <a class="button" href="/participa/">
            Manda tu par <Arrow />
          </a>
        </div>
      </div>
      <ul class="kind-grid">
        {kindSummaries.map((summary) => (
          <li class:list={['kind-card', { empty: summary.count === 0 }]}>
            <Photo src={summary.image} alt={summary.alt} sizes="(max-width: 800px) 45vw, 22vw" />
            <h3>{summary.kind.name}</h3>
            <p>{countLabel(summary.count)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
