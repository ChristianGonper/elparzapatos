---
import Base from '../../layouts/Base.astro';
import PairCard from '../../components/PairCard.astro';
import Invitation from '../../components/Invitation.astro';
import Arrow from '../../components/Arrow.astro';
import { pairs } from '../../data/pairs';
---

<Base
  title="Pares"
  description="Todos los análisis de El Par, con las fotos de quien los comparte y cada detalle explicado."
>
  <section class="wrap page-heading">
    <h1>Pares</h1>
    <p class="lead">
      Cada análisis parte de las fotos de una colaboradora. Elige un par y míralo de cerca.
    </p>
  </section>
  <div class="wrap pair-index">
    {pairs.map((pair) => (
      <PairCard {pair} />
    ))}
    <aside class="index-note">
      <h2>
        ¿Tienes un par que te encante?
        <br />
        <em>Puede ser el siguiente.</em>
      </h2>
      <p>Te contamos cómo hacerle las fotos.</p>
      <a class="text-link" href="/participa/">
        Cómo colaborar <Arrow />
      </a>
    </aside>
  </div>
  <Invitation compact />
</Base>
