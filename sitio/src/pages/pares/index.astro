---
import Base from '../../layouts/Base.astro';
import PairCard from '../../components/PairCard.astro';
import Invitation from '../../components/Invitation.astro';
import Arrow from '../../components/Arrow.astro';
import { pairs } from '../../data/pairs';
---

<Base
  title="Pares"
  description="Un par, muchas cosas que mirar. Lee los análisis de los zapatos compartidos con El Par."
>
  <section class="wrap page-heading">
    <span class="eyebrow">Para mirar con calma</span>
    <h1>Pares</h1>
    <p class="lead">
      Cada par tiene sus detalles. Aquí nos acercamos a ellos, con las fotos y las palabras de quien
      los comparte.
    </p>
  </section>
  <div class="wrap pair-index">
    {pairs.map((pair) => (
      <PairCard {pair} />
    ))}
    <aside class="index-note">
      <span class="eyebrow">Cada par tiene su sitio</span>
      <h2>
        Una colección
        <br />
        <em>que crece contigo.</em>
      </h2>
      <p>Cada nuevo par abre otra forma de mirar. ¿Hay alguno tuyo que te apetezca enseñarnos?</p>
      <a class="text-link" href="/participa/">
        Cómo participar <Arrow />
      </a>
    </aside>
  </div>
  <Invitation compact />
</Base>
