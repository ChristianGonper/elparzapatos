---
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import Arrow from '../../components/Arrow.astro';
import Invitation from '../../components/Invitation.astro';
import ShareLink from '../../components/ShareLink.astro';
import PairCard from '../../components/PairCard.astro';
import { morePortraits } from '../../data/related';
import { pairs, type Pair } from '../../data/pairs';
import { pairImage } from '../../data/images';
import { pairInvitation } from '../../data/invitations';
import { wardrobeForPair, wardrobePath } from '../../data/wardrobes';
export function getStaticPaths() {
  return pairs.map((pair) => ({ params: { slug: pair.slug }, props: { pair } }));
}
interface Props {
  pair: Pair;
}
const { pair } = Astro.props;
const wardrobe = wardrobeForPair(pair);
const more = morePortraits(pair);
Astro.locals.analysis = pair;
const entry = await getEntry('pares', pair.entryId);
if (!entry) throw new Error(`Entrada inexistente: ${pair.entryId}`);
const { Content } = await render(entry);
---

<Base title={pair.title} description={pair.teaser} image={pairImage(pair, pair.hero)}>
  <nav class="wrap breadcrumb" aria-label="Ruta de navegación">
    <a href="/pares/">Pares</a>
    <span aria-hidden="true">/</span>
    <span>{pair.type}</span>
  </nav>
  <article>
    <header class="wrap article-heading">
      <span class="eyebrow">{pair.type}</span>
      <h1>{pair.title}</h1>
      {pair.intro && <p class="lead">{pair.intro}</p>}
      <p class="article-credit">
        Fotos de {pair.credit}
        {wardrobe && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={wardrobePath(wardrobe)}>Armario de {wardrobe.name}</a>
          </>
        )}
      </p>
      <ShareLink kind="par" />
    </header>
    <div class="analysis-content">
      <Content />
    </div>
    <div class="wrap">
      <div class="article-end">
        <a class="text-link" href="/pares/">
          <Arrow direction="left" /> Volver a Pares
        </a>
      </div>
    </div>
  </article>
  {more.length > 0 && (
    <section class="wrap more-portraits" aria-labelledby="mas-retratos">
      <h2 id="mas-retratos">Más retratos</h2>
      <div class="more-portraits-list">
        {more.map((other) => (
          <PairCard
            pair={other}
            heading="h3"
            sizes="(max-width: 700px) 90vw, (max-width: 999px) 45vw, 30vw"
          />
        ))}
      </div>
    </section>
  )}
  <Invitation compact content={pairInvitation(pair)} />
</Base>
