---
/**
 * sobre-el-par.astro — Página Institucional y Explicativa «Sobre El Par»
 * Superficie que rige: sitio/specs/sobre-el-par/spec.md
 * Prototipo de referencia: sitio/archivo-prototipos/sobre-el-par.html
 * Sistema visual y tokens: sitio/DESIGN.md y sitio/src/styles/tokens.css
 */

import LayoutBase from '../layouts/LayoutBase.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// Importación de imágenes optimizadas para el módulo comparativo
import salonNegro from '../assets/marca/salon-negro-en-casa.webp';
import bailarinaBeige from '../assets/marca/bailarina-beige-en-casa.webp';

// Importación de imágenes domésticas para la composición asimétrica de El Método
import alpargataTacon from '../assets/marca/alpargata_tacon_1.webp';
import dorados from '../assets/marca/dorados_1.webp';
import marrones from '../assets/marca/marrones_2.webp';
---

<LayoutBase
  title="Sobre El Par — El Par · Zapatos en detalle"
  currentPath="/sobre-el-par"
>
  <Header currentPath="/sobre-el-par" />

  <main class="sobre-main">
    <!-- 1. CABECERA Y PREÁMBULO INSTITUCIONAL -->
    <header class="sobre-header">
      <span class="kicker-eyebrow">Sobre El Par</span>
      <h1 class="header-title">El calzado visto de cerca</h1>
      <p class="header-lead">
        Una publicación editorial independiente sobre el diseño de los zapatos que tenemos en casa: sus formas, proporciones y construcción.
      </p>
    </header>

    <!-- 2. BLOQUE 1: LA MIRADA -->
    <section class="sobre-section">
      <span class="section-label">La mirada</span>
      <h2 class="section-title">Más que un simple complemento</h2>
      <div class="prose-body">
        <p>
          A menudo hablamos de los zapatos por cómo combinan con la ropa. En El Par nos detenemos en su diseño.
        </p>
        <p>
          Nos interesa cómo se dibuja una puntera, la curva de un escote o la inclinación de un tacón, y cómo esas decisiones dan forma al conjunto.
        </p>
      </div>
    </section>

    <!-- 3. BLOQUE 2: CRITERIO -->
    <section class="sobre-section with-divider">
      <span class="section-label">Criterio</span>
      <h2 class="section-title">Zapatos con carácter propio</h2>
      <div class="prose-body">
        <p>
          Elegimos los pares por su diseño, con independencia de su marca, precio o antigüedad.
        </p>
        <p>
          Nos interesa una silueta, un corte o un detalle que merezca observarse de cerca. La colección crece con esos hallazgos, sin seguir el calendario de las temporadas.
        </p>
      </div>
    </section>

    <!-- 4. BLOQUE 3: FORMAS Y DETALLES -->
    <section class="sobre-section with-divider">
      <div class="section-intro">
        <span class="section-label">Formas y detalles</span>
        <h2 class="section-title">Por qué empezamos por tacones y bailarinas</h2>
        <div class="prose-body">
          <p>
            Empezamos por tacones y bailarinas por la variedad de sus siluetas y las posibilidades que ofrecen para observar el diseño.
          </p>
          <p>
            En una bailarina, la altura de la pala y el recorte de los laterales cambian cuánto queda a la vista del empeine. En un zapato de tacón, la curva del arco y la inclinación o el grosor del tacón modifican el perfil.
          </p>
          <p>
            La colección irá incorporando otras siluetas a medida que la publicación crezca.
          </p>
        </div>
      </div>

      <!-- Módulo comparativo fotográfico -->
      <div class="comparative-module">
        <div class="comparative-grid">
          <!-- Salón de tacón de aguja -->
          <figure class="comparative-figure">
            <div class="comparative-mat">
              <Image
                src={salonNegro}
                alt="Salón de tacón de aguja en vista de perfil"
                class="comparative-image"
                widths={[400, 600, 800]}
                sizes="(max-width: 640px) 100vw, 360px"
              />
            </div>
            <figcaption class="comparative-caption">
              Salón clásico · Línea de calce recta y tacón fino
            </figcaption>
          </figure>

          <!-- Bailarina beige -->
          <figure class="comparative-figure">
            <div class="comparative-mat">
              <Image
                src={bailarinaBeige}
                alt="Bailarina beige fotografiada en un interior doméstico"
                class="comparative-image"
                widths={[400, 600, 800]}
                sizes="(max-width: 640px) 100vw, 360px"
              />
            </div>
            <figcaption class="comparative-caption">
              Bailarina · Puntera redondeada y escote cerrado
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. BLOQUE 4: EL MÉTODO -->
    <section class="sobre-section with-divider">
      <div class="section-intro">
        <span class="section-label">El método</span>
        <h2 class="section-title">Fotografías como las que mandarías a tus amigas</h2>
        <div class="prose-body">
          <p>
            Las fotografías las aportan las personas que comparten sus zapatos con El Par.
          </p>
          <p>
            Están tomadas con el móvil y nos permiten apreciar cada par en su entorno cotidiano.
          </p>
        </div>
      </div>

      <!-- Composición fotográfica asimétrica doméstica -->
      <div class="method-gallery">
        <!-- Imagen principal: Alpargata de cuña -->
        <div class="gallery-primary">
          <div class="gallery-frame">
            <Image
              src={alpargataTacon}
              alt="Alpargata de cuña y pulsera en suelo de madera con luz natural"
              class="gallery-image"
              widths={[500, 800, 1170]}
              sizes="(max-width: 768px) 100vw, 440px"
            />
          </div>
        </div>

        <!-- Imágenes secundarias: Dorados y Marrones -->
        <div class="gallery-secondaries">
          <div class="gallery-frame">
            <Image
              src={dorados}
              alt="Sandalias de tiras doradas metalizadas en suelo de madera"
              class="gallery-image"
              widths={[350, 600, 800]}
              sizes="(max-width: 768px) 50vw, 280px"
            />
          </div>
          <div class="gallery-frame">
            <Image
              src={marrones}
              alt="Sandalias marrones de tiras con tacón geométrico sobre superficie textil"
              class="gallery-image"
              widths={[350, 600, 800]}
              sizes="(max-width: 768px) 50vw, 280px"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. BLOQUE 5: CONVERSACIÓN Y PARTICIPACIÓN -->
    <section class="sobre-section with-divider">
      <div class="section-intro">
        <span class="section-label">Conversación</span>
        <h2 class="section-title">Sugerencias, ideas y colaboraciones</h2>
        <p class="prose-lead">
          Esta publicación se construye junto a la comunidad. Si tienes en mente algún tipo de calzado que crees que deberíamos analizar o simplemente quieres compartir una recomendación o duda con nosotros, puedes escribirnos cuando quieras.
        </p>
      </div>

      <!-- Buzón dual (Correo institucional e Instagram inerte) -->
      <div class="mailbox-grid">
        <a
          href="mailto:elparzapatos@proton.me"
          class="mailbox-card mail-link-card"
          title="Escribir correo a El Par"
        >
          <span class="mailbox-tag">Correo electrónico</span>
          <span class="mailbox-value mail-highlight">elparzapatos@proton.me</span>
          <span class="mailbox-desc">Escríbenos para sugerencias, dudas o consultas.</span>
        </a>

        <div class="mailbox-card inert-card">
          <span class="mailbox-tag">Instagram</span>
          <span class="mailbox-value">@elparzapatos</span>
          <span class="mailbox-desc">Medio en preparación.</span>
        </div>
      </div>

      <!-- Cierre institucional: Invitación hacia Cómo Colaborar -->
      <div class="collab-cta-box">
        <span class="collab-cta-tag">Participa en El Par</span>
        <h3 class="collab-cta-title">¿Te gustaría ver aquí un par tuyo?</h3>
        <p class="collab-cta-text">
          Si tienes un par que te gustaría compartir, puedes enviarnos sus fotografías y contarnos qué te gusta de él.
        </p>
        <div class="collab-cta-action">
          <a href="/como-colaborar" class="collab-cta-btn">
            <span>Descubre cómo colaborar</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer currentPath="/sobre-el-par" />
</LayoutBase>

<style>
  /* ==========================================================================
     PÁGINA INSTITUCIONAL SOBRE EL PAR
     ========================================================================== */
  .sobre-main {
    flex-grow: 1;
    max-width: 48rem; /* ~768px / max-w-3xl */
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-20);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 640px) {
    .sobre-main {
      padding: var(--space-20) var(--space-10) var(--space-24);
      gap: var(--space-20);
    }
  }

  /* ==========================================================================
     CABECERA Y PREÁMBULO
     ========================================================================== */
  .sobre-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-bottom: 1px solid var(--color-hairline);
    padding-bottom: var(--space-12);
  }

  .kicker-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    color: var(--color-cognac);
    font-weight: 500;
    display: block;
  }

  .header-title {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    color: var(--color-ink);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    margin: 0;
  }

  @media (min-width: 640px) {
    .header-title {
      font-size: var(--text-5xl);
    }
  }

  .header-lead {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-graphite);
    line-height: var(--leading-snug);
    font-weight: 400;
    margin: 0;
  }

  @media (min-width: 640px) {
    .header-lead {
      font-size: var(--text-2xl);
    }
  }

  /* ==========================================================================
     BLOQUES TEMÁTICOS SECUENCIADOS
     ========================================================================== */
  .sobre-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sobre-section.with-divider {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-12);
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-graphite);
    display: block;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-ink);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  @media (min-width: 640px) {
    .section-title {
      font-size: var(--text-3xl);
    }
  }

  .prose-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-graphite);
    line-height: var(--leading-prose);
  }

  @media (min-width: 640px) {
    .prose-body {
      font-size: var(--text-lg);
    }
  }

  .prose-body p {
    margin: 0;
  }

  .prose-lead {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-graphite);
    line-height: var(--leading-prose);
    margin: 0;
  }

  @media (min-width: 640px) {
    .prose-lead {
      font-size: var(--text-lg);
    }
  }

  /* ==========================================================================
     MÓDULO COMPARATIVO FOTOGRÁFICO (FORMAS Y DETALLES)
     ========================================================================== */
  .comparative-module {
    margin-top: var(--space-6);
    background-color: var(--color-specimen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  @media (min-width: 640px) {
    .comparative-module {
      padding: var(--space-8);
    }
  }

  .comparative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .comparative-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .comparative-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  .comparative-mat {
    aspect-ratio: 4 / 3;
    background-color: rgba(243, 239, 234, 0.5); /* var(--color-linen) at 50% */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border: 1px solid rgba(232, 227, 220, 0.7);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .comparative-image {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .comparative-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* ~11px */
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-graphite);
    display: block;
    line-height: var(--leading-mono);
  }

  /* ==========================================================================
     COMPOSICIÓN FOTOGRÁFICA ASIMÉTRICA (EL MÉTODO)
     ========================================================================== */
  .method-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .method-gallery {
      grid-template-columns: 7fr 5fr;
      align-items: start;
    }
  }

  .gallery-primary {
    width: 100%;
  }

  .gallery-secondaries {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .gallery-secondaries {
      grid-template-columns: 1fr;
    }
  }

  .gallery-frame {
    background-color: var(--color-specimen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .gallery-frame {
      padding: var(--space-3);
    }
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
  }

  /* ==========================================================================
     BUZÓN DUAL (CONVERSACIÓN)
     ========================================================================== */
  .mailbox-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .mailbox-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .mailbox-card {
    padding: var(--space-5);
    background-color: var(--color-linen);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    transition: border-color var(--transition-hover);
  }

  .mail-link-card {
    min-height: var(--min-tap-target);
  }

  .mail-link-card:hover {
    border-color: rgba(158, 107, 85, 0.6);
  }

  .mail-link-card:hover .mail-highlight {
    color: var(--color-cognac);
  }

  .inert-card {
    cursor: default;
    user-select: none;
  }

  .mailbox-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-wide);
    color: var(--color-cognac);
    font-weight: 500;
    display: block;
  }

  .mailbox-value {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-ink);
    font-weight: 500;
    transition: color var(--transition-hover);
    overflow-wrap: anywhere;
  }

  .mailbox-desc {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-graphite);
    display: block;
    line-height: var(--leading-normal);
  }

  /* ==========================================================================
     LLAMADA A LA ACCIÓN EDITORIAL (PARTICIPA EN EL PAR)
     ========================================================================== */
  .collab-cta-box {
    margin-top: var(--space-6);
    padding: var(--space-8);
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-ink);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .collab-cta-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    color: var(--color-cognac);
    font-weight: 500;
    display: block;
  }

  .collab-cta-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-paper);
    font-weight: 400;
    line-height: var(--leading-tight);
    margin: 0;
  }

  .collab-cta-text {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: rgba(243, 239, 234, 0.85); /* linen suave */
    line-height: var(--leading-prose);
    max-width: 36rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .collab-cta-text {
      font-size: var(--text-base);
    }
  }

  .collab-cta-action {
    padding-top: var(--space-2);
  }

  .collab-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--min-tap-target);
    background-color: var(--color-cognac);
    color: var(--color-paper);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono-widest);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-hover);
  }

  .collab-cta-btn:hover {
    background-color: var(--color-cognac-dark);
  }

  .btn-arrow {
    transition: transform var(--transition-hover);
  }

  .collab-cta-btn:hover .btn-arrow {
    transform: translateX(3px);
  }
</style>
