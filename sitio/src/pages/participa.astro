---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import Invitation from '../components/Invitation.astro';
import QuickSend from '../components/QuickSend.astro';
import { site } from '../data/site';
import { exampleImage, guideImage } from '../data/images';
import { pairs, pairPath } from '../data/pairs';
import { anonymousCreditExample, removalHours, reviewHours } from '../data/participation';
const examplePair = pairs.find((pair) => pair.entryId === 'par-0003');
const examples = [
  {
    image: guideImage(5),
    name: 'Bailarinas',
    text: 'La forma de la puntera, la abertura o un pequeño adorno.',
  },
  {
    image: exampleImage('marrones_2'),
    name: 'Tacones y tiras',
    text: 'La forma del tacón y el recorrido de las tiras.',
  },
  {
    image: exampleImage('alpargata_tacon_1'),
    name: 'Cuñas y alpargatas',
    text: 'La base cambia toda la silueta.',
  },
  {
    image: exampleImage('dorados_1'),
    name: 'Plataformas',
    text: 'Una suela que gana altura y cambia las proporciones.',
  },
];
const faqs = [
  {
    q: '¿Qué pares sirven?',
    a: 'Cualquiera con dos o tres detalles que se puedan señalar en una foto. No importa la marca ni el precio. Ahora miramos bailarinas, salones, sandalias de tacón, cuñas, plataformas y alpargatas; las botas y las sandalias planas, de momento, no.',
  },
  {
    q: '¿Qué se publica?',
    a: 'El análisis con tus fotos, en la web, en Instagram y en una futura newsletter de El Par. Solo salen los zapatos, nunca tú. Retocamos lo justo (luz, encuadre, enderezar) y nunca usamos IA generativa con tus fotos.',
  },
  {
    q: '¿Cómo aparezco?',
    a: `Como prefieras: con tu nombre, con tu @ de Instagram o de forma anónima. Si eliges el anonimato, sales como «Colaboradora» con tu número de dos cifras, siempre el mismo (por ejemplo, «${anonymousCreditExample}»).`,
  },
  {
    q: '¿Qué pasa después de enviarlo?',
    a: `Miramos las fotos y, si falta alguna vista, te la pedimos. Preparamos el análisis y te lo mandamos: tienes ${reviewHours} horas para pedir cambios. Si no contestas, se publica, y te avisamos cuando esté en la web.`,
  },
  {
    q: '¿Puedo pedir que lo quitéis?',
    a: `Sí, cuando quieras. Escríbenos o dínoslo por donde hablamos contigo y lo quitamos de la web y de nuestras redes en un máximo de ${removalHours} horas. Te preguntamos también si quieres que borremos las fotos originales.`,
  },
  {
    q: '¿Puedo mandar más de un par?',
    a: 'Sí, todos los que quieras: varios en el mismo envío o en envíos distintos, cuando te apetezca. Cada par tiene su análisis en Pares y, desde el segundo publicado, los reunimos también en tu armario.',
  },
];
---

<Base
  title="Cómo colaborar"
  description="Hazle unas fotos con el móvil a ese par que te encanta y envíanoslas. Qué pares encajan, cómo apareces y qué pasa después."
>
  <section class="wrap collaboration-hero">
    <div>
      <span class="eyebrow">Un armario creado entre todas</span>
      <h1>
        Ese par que te encanta.
        <br />
        <em>Nos gustaría verlo.</em>
      </h1>
      <p class="lead">Le haces unas fotos con el móvil, nos las envías y lo miramos de cerca.</p>
      <QuickSend />
    </div>
    <div class="hero-image">
      {examplePair ? (
        <a
          href={pairPath(examplePair)}
          aria-label={`Leer el análisis del par de María: ${examplePair.title}`}
        >
          <figure>
            <Photo
              src={guideImage(5)}
              alt="El par de bailarinas de rejilla que María ha compartido con El Par"
              priority
              sizes="(max-width: 800px) 90vw, 45vw"
            />
            <figcaption>
              <span>María ya nos ha enseñado las suyas.</span>
              <Arrow />
            </figcaption>
          </figure>
        </a>
      ) : (
        <figure>
          <Photo
            src={guideImage(5)}
            alt="Las bailarinas de María como ejemplo de las fotos"
            priority
            sizes="(max-width: 800px) 90vw, 45vw"
          />
          <figcaption>Fotos de María para la guía.</figcaption>
        </figure>
      )}
    </div>
  </section>
  <ul class="wrap reassurance-strip">
    <li>Con el móvil, en casa</li>
    <li>Tú eliges cómo apareces</li>
    <li>Lo lees antes de publicarlo</li>
  </ul>
  <section class="wrap section steps-intro">
    <div>
      <span class="eyebrow">Así de sencillo</span>
      <h2>
        Tú haces las fotos.
        <br />
        <em>Nosotros miramos cada detalle.</em>
      </h2>
    </div>
    <div>
      <ol class="steps">
        <li>
          <h3>Elige un par que te guste</h3>
          <p>
            No tiene que ser caro ni raro. Piensa en lo que te llamó la atención: la punta, una
            hebilla, un brillo, unas tiras.
          </p>
        </li>
        <li>
          <h3>Hazle unas fotos</h3>
          <p>
            Con el móvil y un fondo sencillo: seis vistas y los detalles que más te gusten. En la
            guía te enseñamos cada vista.
          </p>
        </li>
        <li>
          <h3>Envíanoslas</h3>
          <p>
            Subes las fotos al formulario, nos cuentas qué te gusta del par y eliges cómo quieres
            aparecer. La marca y el modelo, si los recuerdas.
          </p>
        </li>
        <li>
          <h3>Lo lees antes que nadie</h3>
          <p>
            {`Te mandamos el análisis y tienes ${reviewHours} horas para pedir cambios. Cuando se publica, te avisamos.`}
          </p>
        </li>
      </ol>
    </div>
  </section>
  <section class="examples-section section">
    <div class="wrap">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow">Qué pares buscamos</span>
          <h2>¿Encajan los tuyos?</h2>
        </div>
        <p>
          Zapatos con dos o tres detalles que se puedan señalar en una foto: una puntera con forma
          propia, un tacón, unas tiras, una suela que cambia la silueta.
        </p>
      </div>
      <div class="example-grid">
        {examples.map((example) => (
          <figure>
            <Photo src={example.image} alt={example.name} sizes="(max-width: 800px) 45vw, 22vw" />
            <figcaption>
              <h3>{example.name}</h3>
              <p>{example.text}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="look-note">
        De momento dejamos fuera las botas y las sandalias planas. Si dudas con un par,{' '}
        <a class="text-link" href={`mailto:${site.email}`}>
          escríbenos <Arrow />
        </a>
        .
      </p>
    </div>
  </section>
  <section class="wrap section photo-guide-summary">
    <figure class="guide-preview">
      <Photo
        src={guideImage(2)}
        alt="Vista lateral de las bailarinas de María como ejemplo de la guía"
        sizes="(max-width: 800px) 90vw, 45vw"
      />
      <figcaption>Las bailarinas de María, de perfil.</figcaption>
    </figure>
    <div>
      <span class="eyebrow">Sin fotos profesionales</span>
      <h2>
        Un fondo sencillo.
        <br />
        <em>Y un poco de luz.</em>
      </h2>
      <p class="lead">
        Las fotos que harías para enseñarle tus zapatos a una amiga. En la guía tienes las seis
        vistas, con las bailarinas de María como ejemplo.
      </p>
    </div>
  </section>
  <section class="wrap section faq-section" style="padding-top:0">
    <div>
      <span class="eyebrow">Antes de enviarlos</span>
      <h2>
        Lo que quizá
        <br />
        <em>te estás preguntando.</em>
      </h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <div>
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
      <details>
        <summary>¿Cómo os escribo?</summary>
        <div>
          <p>
            A <a href={`mailto:${site.email}`}>{site.email}</a>. Y todo sobre tus fotos y tus datos,{' '}
            <a href="/tus-fotos-y-tus-datos/">aquí</a>.
          </p>
        </div>
      </details>
    </div>
  </section>
  <Invitation compact next="guia" />
</Base>
